us: 20px;\n      font-size: 13px;\n      font-weight: 600;\n      cursor: pointer;\n    }\n    .dict-btn-save {\n      flex: 1;\n      background: var(--sp-green);\n      color: #000;\n      border: none;\n      padding: 10px 16px;\n      border-radius: 20px;\n      font-size: 13px;\n      font-weight: 700;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 6px;\n    }\n    .dict-btn-save:hover {\n      background: var(--sp-green-hover);\n    }\n\n    .popup-backdrop {\n      position: fixed;\n      inset: 0;\n      background: rgba(0, 0, 0, 0.75);\n      backdrop-filter: blur(4px);\n      z-index: 999;\n      display: none;\n    }\n\n    /* ==================== 4. SPOTIFY MUSIC LOUNGE ==================== */\n    .sp-hero { margin-bottom: 24px; }\n    .sp-hero h1 { font-size: 30px; font-weight: 800; margin-bottom: 6px; }\n    .sp-hero p { color: var(--sp-light-gray); font-size: 14px; }\n    .sp-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));\n      gap: 20px;\n      margin-bottom: 30px;\n    }\n    .sp-card {\n      background: var(--sp-dark-gray);\n      border-radius: 10px;\n      padding: 14px;\n      transition: var(--transition);\n      cursor: pointer;\n      position: relative;\n    }\n    .sp-card:hover { background: var(--sp-card-gray); transform: translateY(-4px); }\n    .sp-card-img-wrap {\n      width: 100%;\n      aspect-ratio: 1;\n      border-radius: 8px;\n      overflow: hidden;\n      margin-bottom: 12px;\n      position: relative;\n      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);\n      background: #111;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .sp-card-img { width: 100%; height: 100%; object-fit: cover; }\n    .sp-card-play {\n      position: absolute;\n      bottom: 10px;\n      right: 10px;\n      width: 44px;\n      height: 44px;\n      border-radius: 50%;\n      background: var(--sp-green);\n      color: #000;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 20px;\n      opacity: 0;\n      transform: translateY(8px);\n      transition: var(--transition);\n      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);\n    }\n    .sp-card:hover .sp-card-play { opacity: 1; transform: translateY(0); }\n    .sp-card-title { font-size: 14px; font-weight: 700; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    .sp-card-desc { font-size: 12px; color: var(--sp-light-gray); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4; }\n\n    .sp-lyrics-section {\n      background: #18281e;\n      border-radius: 16px;\n      padding: 24px;\n      display: flex;\n      flex-direction: column;\n      height: 450px;\n      overflow: hidden;\n      border: 1px solid var(--sp-border);\n    }\n    .sp-lyrics-title { font-size: 18px; font-weight: 800; margin-bottom: 16px; display: flex; justify-content: space-between; }\n    .sp-lyrics-scroll { flex: 1; overflow-y: auto; padding: 20px 0; display: flex; flex-direction: column; gap: 18px; scroll-behavior: smooth; }\n    .sp-lrc-line { font-size: 20px; font-weight: 700; color: rgba(255, 255, 255, 0.35); transition: var(--transition); cursor: pointer; line-height: 1.5; }\n    .sp-lrc-line:hover { color: rgba(255, 255, 255, 0.7); }\n    .sp-lrc-line.active { font-size: 26px; color: #ffffff; transform: scale(1.02); transform-origin: left center; }\n\n    /* ==================== 5. VOCABULARY VAULT ==================== */\n    .vault-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }\n    .vault-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }\n    .vault-card {\n      background: var(--sp-dark-gray);\n      border: 1px solid var(--sp-border);\n      border-radius: 12px;\n      padding: 16px;\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      transition: var(--transition);\n    }\n    .vault-card:hover { background: var(--sp-card-gray); border-color: rgba(255, 255, 255, 0.15); }\n    .vault-top { display: flex; justify-content: space-between; align-items: center; }\n    .vault-word { font-size: 20px; font-weight: 800; color: var(--vt-gold); }\n    .vault-phonetic { font-family: var(--font-mono); font-size: 12px; color: var(--sp-light-gray); }\n    .vault-meaning { font-size: 13px; line-height: 1.5; color: #e2e8f0; }\n    .vault-ctx { font-size: 12px; color: var(--sp-light-gray); font-style: italic; border-left: 2px solid var(--sp-green); padding-left: 8px; }\n\n    /* ==================== BOTTOM SPOTIFY BAR ==================== */\n    .bottom-bar {\n      grid-column: 1 / -1;\n      background-color: var(--sp-dark-gray);\n      border-top: 1px solid var(--sp-border);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 24px;\n      z-index: 100;\n    }\n    .bar-left { display: flex; align-items: center; gap: 14px; width: 280px; min-width: 180px; }\n    .bar-cover { width: 56px; height: 56px; border-radius: 6px; object-fit: cover; }\n    .bar-meta { display: flex; flex-direction: column; gap: 2px; overflow: hidden; }\n    .bar-title { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    .bar-artist { font-size: 12px; color: var(--sp-light-gray); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    .heart-btn { background: transparent; border: none; color: var(--sp-light-gray); font-size: 18px; cursor: pointer; }\n    .heart-btn.liked { color: var(--sp-green); }\n    .bar-center { flex: 1; max-width: 650px; display: flex; flex-direction: column; align-items: center; gap: 6px; }\n    .center-buttons { display: flex; align-items: center; gap: 18px; }\n    .player-btn { background: transparent; border: none; color: var(--sp-light-gray); font-size: 16px; cursor: pointer; transition: var(--transition); }\n    .player-btn:hover { color: var(--sp-white); transform: scale(1.1); }\n    .player-btn.play-circle { width: 38px; height: 38px; background: var(--sp-white); color: #000; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; }\n    .player-btn.play-circle:hover { background: var(--sp-green); transform: scale(1.08); }\n    .playback-bar { width: 100%; display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; color: var(--sp-light-gray); }\n    .progress-track { flex: 1; height: 4px; background: rgba(255, 255, 255, 0.2); border-radius: 4px; position: relative; cursor: pointer; }\n    .progress-track:hover { height: 6px; }\n    .progress-fill { height: 100%; background: var(--sp-white); border-radius: 4px; width: 0%; transition: width 0.1s linear; }\n    .progress-track:hover .progress-fill { background: var(--sp-green); }\n    .bar-right { display: flex; align-items: center; gap: 14px; width: 240px; justify-content: flex-end; }\n    .vol-slider { width: 90px; accent-color: var(--sp-green); cursor: pointer; }\n\n    @media (max-width: 900px) {\n      .app-shell { grid-template-columns: 1fr; }\n      .sidebar { display: none; }\n      .vt-layout { grid-template-columns: 1fr; }\n    }\n  \n    /* ==================== 4.1 SPOTIFY DETAILED TRACK TABLE ==================== */\n    .sp-table-toolbar {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin: 18px 0 14px 0;\n      flex-wrap: wrap;\n      gap: 12px;\n    }\n    .sp-search-box {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      background: rgba(255, 255, 255, 0.08);\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      border-radius: 20px;\n      padding: 6px 14px;\n      width: 280px;\n    }\n    .sp-search-box input {\n      background: transparent;\n      border: none;\n      outline: none;\n      color: #fff;\n      font-size: 13px;\n      width: 100%;\n    }\n    .sp-view-toggle-btns {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n    .sp-table-wrap {\n      background: rgba(18, 18, 18, 0.6);\n      border: 1px solid var(--sp-border);\n      border-radius: 12px;\n      overflow: hidden;\n      margin-bottom: 24px;\n    }\n    .sp-track-table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 13.5px;\n    }\n    .sp-track-table th {\n      padding: 12px 16px;\n      text-align: left;\n      font-size: 11.5px;\n      font-weight: 700;\n      color: var(--sp-light-gray);\n      text-transform: uppercase;\n      letter-spacing: 0.8px;\n      border-bottom: 1px solid var(--sp-border);\n      background: rgba(255, 255, 255, 0.03);\n    }\n    .sp-track-row {\n      cursor: pointer;\n      transition: background 0.15s ease;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.04);\n    }\n    .sp-track-row:hover {\n      background: rgba(255, 255, 255, 0.08);\n    }\n    .sp-track-row.active {\n      background: rgba(29, 185, 84, 0.15);\n      color: var(--sp-green);\n      font-weight: 700;\n    }\n    .sp-track-row td {\n      padding: 12px 16px;\n      vertical-align: middle;\n    }\n    .track-num-cell {\n      width: 44px;\n      text-align: center;\n      font-family: var(--font-mono);\n      color: var(--sp-light-gray);\n      font-size: 13px;\n    }\n    .sp-track-row.active .track-num-cell {\n      color: var(--sp-green);\n    }\n    .track-title-cell {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      font-weight: 600;\n      color: #fff;\n    }\n    .sp-track-row.active .track-title-cell {\n      color: var(--sp-green);\n    }\n    .track-icon-disk {\n      font-size: 16px;\n      opacity: 0.8;\n    }\n    .track-source-cell {\n      color: var(--sp-light-gray);\n      font-size: 12px;\n    }\n    .track-badge-cell {\n      text-align: center;\n    }\n    .track-status-pill {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      padding: 3px 10px;\n      border-radius: 12px;\n      font-size: 11px;\n      font-weight: 700;\n      background: rgba(255, 255, 255, 0.06);\n      color: var(--sp-light-gray);\n    }\n    .track-status-pill.playing {\n      background: var(--sp-green);\n      color: #000;\n      box-shadow: 0 0 10px var(--sp-green-glow);\n    }\n    .track-action-cell {\n      text-align: right;\n    }\n    .row-play-btn {\n      background: transparent;\n      border: none;\n      color: var(--sp-light-gray);\n      font-size: 16px;\n      cursor: pointer;\n      padding: 4px 8px;\n      transition: transform 0.15s, color 0.15s;\n    }\n    .row-play-btn:hover {\n      color: var(--sp-green);\n      transform: scale(1.2);\n    }\n\n    /* ==================== 4.2 PLAYING LIST (QUEUE DRAWER) ==================== */\n    .queue-drawer {\n      display: none;\n      background: #181818;\n      border: 1px solid var(--sp-border);\n      border-radius: 14px;\n      padding: 18px;\n      margin-bottom: 24px;\n      animation: fadeIn 0.2s ease;\n    }\n    .queue-drawer.show {\n      display: block;\n    }\n    .queue-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 14px;\n      border-bottom: 1px solid var(--sp-border);\n      padding-bottom: 10px;\n    }\n    .queue-title {\n      font-size: 16px;\n      font-weight: 800;\n      color: var(--vt-gold);\n    }\n    .queue-list {\n      max-height: 280px;\n      overflow-y: auto;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n    }\n    .queue-item {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 8px 12px;\n      background: rgba(255, 255, 255, 0.03);\n      border-radius: 8px;\n      cursor: pointer;\n      font-size: 13px;\n      transition: background 0.15s;\n    }\n    .queue-item:hover {\n      background: rgba(255, 255, 255, 0.08);\n    }\n    .queue-item.current {\n      background: rgba(29, 185, 84, 0.15);\n      border-left: 3px solid var(--sp-green);\n      color: var(--sp-green);\n      font-weight: 700;\n    }\n\n    /* ==================== 4.3 ENLARGED LOOP & REPEAT BUTTONS ==================== */\n    .player-pill-control {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      padding: 8px 16px !important;\n      border-radius: 24px !important;\n      font-size: 13px !important;\n      font-weight: 700 !important;\n      background: rgba(255, 255, 255, 0.08) !important;\n      border: 1px solid rgba(255, 255, 255, 0.2) !important;\n      color: var(--sp-light-gray) !important;\n      cursor: pointer;\n      transition: all 0.2s cubic-bezier(0.3, 0, 0.2, 1) !important;\n    }\n    .player-pill-control:hover {\n      background: rgba(255, 255, 255, 0.15) !important;\n      color: #fff !important;\n      transform: scale(1.05);\n    }\n    .player-pill-control.active-loop {\n      background: rgba(29, 185, 84, 0.2) !important;\n      border-color: var(--sp-green) !important;\n      color: var(--sp-green) !important;\n      box-shadow: 0 0 12px var(--sp-green-glow);\n    }\n    .player-pill-control.active-repeat {\n      background: rgba(245, 158, 11, 0.2) !important;\n      border-color: var(--vt-gold) !important;\n      color: var(--vt-gold) !important;\n      box-shadow: 0 0 12px rgba(245, 158, 11, 0.3);\n    }\n\n    /* ==================== 4.4 VOICETUBE AUTO-READING STYLES ==================== */\n    .sub-row.speaking {\n      border: 2px solid var(--sp-green) !important;\n      background: rgba(29, 185, 84, 0.12) !important;\n      box-shadow: 0 0 16px var(--sp-green-glow);\n      transform: scale(1.01);\n    }\n    .sub-row.speaking .sub-time {\n      color: var(--sp-green);\n      font-weight: 800;\n    }\n    .vt-play-btn-prominent {\n      background: var(--sp-green) !important;\n      color: #000 !important;\n      font-weight: 800 !important;\n      font-size: 14px !important;\n      padding: 10px 20px !important;\n      border-radius: 24px !important;\n      box-shadow: 0 4px 15px var(--sp-green-glow) !important;\n      transition: all 0.2s !important;\n    }\n    .vt-play-btn-prominent:hover {\n      background: var(--sp-green-hover) !important;\n      transform: scale(1.05) !important;\n    }\n    .vt-play-btn-prominent.reading {\n      background: #ef4444 !important;\n      color: #fff !important;\n      box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4) !important;\n    }\n\n  \n    /* ==================== FOLDER PILLS & CATEGORY BADGES ==================== */\n    .folder-pills-row {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      flex-wrap: wrap;\n    }\n    .folder-pill {\n      background: var(--sp-card-gray);\n      border: 1px solid var(--sp-border);\n      color: var(--sp-light-gray);\n      padding: 6px 14px;\n      border-radius: 20px;\n      font-size: 13px;\n      font-weight: 600;\n      cursor: pointer;\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      transition: var(--transition);\n      user-select: none;\n    }\n    .folder-pill:hover {\n      background: var(--sp-card-hover);\n      color: var(--sp-white);\n      border-color: rgba(255, 255, 255, 0.2);\n    }\n    .folder-pill.active {\n      background: var(--sp-green);\n      color: #000;\n      border-color: var(--sp-green);\n      font-weight: 700;\n      box-shadow: 0 2px 10px var(--sp-green-glow);\n    }\n    .folder-pill.kline-pill.active {\n      background: #06b6d4;\n      color: #000;\n      border-color: #06b6d4;\n      box-shadow: 0 2px 10px rgba(6, 182, 212, 0.35);\n    }\n    .badge-folder {\n      display: inline-flex;\n      align-items: center;\n      gap: 3px;\n      padding: 2px 8px;\n      border-radius: 12px;\n      font-size: 11px;\n      font-weight: 700;\n      margin-right: 6px;\n    }\n    .badge-ev {\n      background: rgba(29, 185, 84, 0.18);\n      color: #4ade80;\n      border: 1px solid rgba(29, 185, 84, 0.4);\n    }\n    .badge-kline {\n      background: rgba(6, 182, 212, 0.18);\n      color: #22d3ee;\n      border: 1px solid rgba(6, 182, 212, 0.4);\n    }\n\n  \n    /* ==================== DRAG & DROP SONG REORDERING ==================== */\n    .sp-track-row[draggable=\"true\"] {\n      cursor: grab;\n      user-select: none;\n    }\n    .sp-track-row[draggable=\"true\"]:active {\n      cursor: grabbing;\n    }\n    .sp-track-row.is-dragging {\n      opacity: 0.35 !important;\n      background: rgba(29, 185, 84, 0.22) !important;\n      outline: 2px dashed var(--sp-green) !important;\n    }\n    .sp-track-row.drag-over-top td {\n      border-top: 3px solid var(--sp-green) !important;\n    }\n    .sp-track-row.drag-over-bottom td {\n      border-bottom: 3px solid var(--sp-green) !important;\n    }\n    .drag-handle-cell {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 6px;\n    }\n    .drag-handle {\n      cursor: grab;\n      font-size: 15px;\n      opacity: 0.45;\n      user-select: none;\n      transition: opacity 0.2s, transform 0.2s, color 0.2s;\n    }\n    .sp-track-row:hover .drag-handle {\n      opacity: 1 !important;\n      color: var(--sp-green);\n      transform: scale(1.2);\n    }\n    .queue-item[draggable=\"true\"] {\n      cursor: grab;\n      user-select: none;\n      transition: background 0.15s;\n    }\n    .queue-item.is-dragging {\n      opacity: 0.35 !important;\n      outline: 2px dashed var(--sp-green) !important;\n    }\n    .queue-item.drag-over-top {\n      border-top: 2px solid var(--sp-green) !important;\n    }\n    .queue-item.drag-over-bottom {\n      border-bottom: 2px solid var(--sp-green) !important;\n    }\n\n  </style>\n</head>\n<body>\n\n  <!-- Backdrop for Modals -->\n  <div id=\"dict-backdrop\" class=\"popup-backdrop\"></div>\n\n  <!-- Floating Selection Tooltip -->\n  <div id=\"selection-tooltip\">➕ 存為生字卡</div>\n\n  <!-- VoiceTube Click-to-Translate & Add to Flashcard Modal -->\n  <div id=\"dict-popup\" class=\"vt-dict-popup\">\n    <div class=\"dict-header\">\n      <div>\n        <div class=\"dict-word-title\" id=\"dict-title\">Shrinkflation</div>\n        <div class=\"dict-phonetic\" id=\"dict-phonetic\">/ˈʃrɪŋk.fleɪ.ʃən/</div>\n      </div>\n      <button class=\"dict-close\" id=\"dict-close-btn\">✕</button>\n    </div>\n    <div class=\"dict-body\">\n      <div class=\"dict-meaning\" id=\"dict-meaning\">\n        【名】縮水式通膨（售價維持不變，但包裝或份量實質縮小）\n      </div>\n      <div class=\"dict-example-preview\">\n        <div class=\"dict-example-label\">📌 自動收錄文章原句為例句：</div>\n        <div class=\"dict-context\" id=\"dict-context\">\n          “Shrinkflation occurs when the price of a product remains the same...”\n        </div>\n      </div>\n    </div>\n    <div class=\"dict-actions\">\n      <button class=\"dict-btn-voice\" id=\"dict-voice-btn\">🔊 單字發音</button>\n      <button class=\"dict-btn-save\" id=\"dict-save-btn\">\n        <span>📇 存為生字卡 (含例句)</span>\n      </button>\n    </div>\n  </div>\n\n  <!-- App Shell -->\n  <div class=\"app-shell\">\n\n    <!-- ==================== SIDEBAR ==================== -->\n    <aside class=\"sidebar\">\n      <div class=\"brand-logo\">\n        <div class=\"brand-logo-icon\">🎧</div>\n        <div>\n          <div class=\"brand-name\">OSCARMARK</div>\n          <div class=\"brand-sub\">Studio Pro</div>\n        </div>\n      </div>\n\n      <nav class=\"nav-group\">\n        <div class=\"nav-label\">主要模式</div>\n        <button class=\"nav-item active\" data-view=\"english-view\">\n          <span class=\"nav-icon\">📚</span>\n          <span>VoiceTube 英語精讀</span>\n        </button>\n        <button class=\"nav-item\" data-view=\"flashcards-view\">\n          <span class=\"nav-icon\">📇</span>\n          <span>生字卡複習 (<span id=\"sidebar-fc-count\">0</span>)</span>\n        </button>\n        <button class=\"nav-item\" data-view=\"music-view\">\n          <span class=\"nav-icon\">🎵</span>\n          <span>Spotify 音樂館 (<span id=\"sidebar-music-count\">0</span>)</span>\n        </button>\n        <button class=\"nav-item\" data-view=\"youtube-view\">\n          <span class=\"nav-icon\">📥</span>\n          <span>YouTube 轉 MP3</span>\n          <span style=\"background: #ef4444; color: white; font-size: 10px; font-weight: 800; padding: 2px 7px; border-radius: 10px; margin-left: auto;\">320k</span>\n        </button>\n        <button class=\"nav-item\" data-view=\"vault-view\">\n          <span class=\"nav-icon\">⭐</span>\n          <span>生詞資料庫</span>\n        </button>\n      </nav>\n\n      <div class=\"sidebar-divider\"></div>\n\n      <!-- Drive Sync Status -->\n      <div class=\"drive-status-card\">\n        <h4>☁️ Google 雲端硬碟庫</h4>\n        <p id=\"drive-stats-text\">正在讀取雲端資料庫...</p>\n        <button class=\"vt-btn\" id=\"refresh-drive-btn\" style=\"padding: 4px 8px; font-size: 11px;\">🔄 重新掃描雲端</button>\n      </div>\n\n      <div class=\"sidebar-ambient-card\">\n        <h4>🌧️ 專注白噪音伴讀</h4>\n        <p>在學習或聽歌時疊加自然雨聲與咖啡館環境音。</p>\n        <button class=\"ambient-open-btn\" id=\"ambient-toggle-btn\">開啟混音器</button>\n      </div>\n    </aside>\n\n    <!-- ==================== MAIN VIEWPORT ==================== -->\n    <main class=\"main-view\">\n\n      <!-- PANE 1: VOICETUBE ENGLISH HUB -->\n      <section id=\"english-view\" class=\"view-pane active\">\n        <div class=\"vt-header\">\n          <div class=\"vt-title-box\">\n            <h1>📚 VoiceTube 沉浸式英語學習</h1>\n            <p>點選文章單字或滑鼠圈選片語，自動將單字與<strong>當前句子收錄為生字卡與例句</strong>。</p>\n          </div>\n          <div class=\"vt-header-right\" style=\"display: flex; flex-direction: column; align-items: flex-end; gap: 8px;\">\n            <div class=\"folder-pills-row\" id=\"vt-folder-pills\">\n              <button class=\"folder-pill active\" data-vt-folder=\"all\">📁 全部 (<span id=\"vt-art-count-all\">0</span>)</button>\n              <button class=\"folder-pill\" data-vt-folder=\"Englishvoice\">📘 Englishvoice (<span id=\"vt-art-count-ev\">0</span>)</button>\n              <button class=\"folder-pill kline-pill\" data-vt-folder=\"KLine\">📈 KLine (<span id=\"vt-art-count-kline\">0</span>)</button>\n            </div>\n            <div class=\"vt-lesson-picker\">\n              <select class=\"vt-select\" id=\"lesson-selector\">\n                <option value=\"\">正在掃描雲端文章庫...</option>\n              </select>\n              <button class=\"vt-btn\" id=\"toggle-drawer-btn\">📝 貼上新文章</button>\n              <button class=\"vt-btn gold\" id=\"jump-to-fc-btn\">📇 查看生字卡</button>\n            </div>\n          </div>\n        </div>\n\n        <!-- Article Input / Save Drawer -->\n        <div class=\"article-drawer\" id=\"article-drawer\">\n          <textarea id=\"raw-article-input\" placeholder=\"請在此貼上英文文章內容...\"></textarea>\n          <div class=\"drawer-actions\" style=\"display: flex; gap: 10px; align-items: center; flex-wrap: wrap;\">\n            <div style=\"display: flex; align-items: center; gap: 6px;\">\n              <span style=\"font-size: 12px; color: var(--sp-light-gray);\">儲存目標：</span>\n              <select id=\"article-target-folder\" class=\"vt-select\" style=\"padding: 6px 12px; font-size: 13px; border-radius: 8px;\">\n                <option value=\"KLine\">📈 KLine 資料夾</option>\n                <option value=\"Englishvoice\" selected>📘 Englishvoice 資料夾</option>\n              </select>\n            </div>\n            <input type=\"text\" id=\"article-save-name\" class=\"drawer-input\" placeholder=\"儲存至 Google Drive 的檔名 (例如: KLine_01)\" style=\"flex: 1;\">\n            <button class=\"vt-btn active\" id=\"parse-article-btn\">解析並翻譯文章</button>\n            <button class=\"vt-btn\" id=\"save-article-drive-btn\">儲存到雲端硬碟</button>\n          </div>\n        </div>\n\n        <div class=\"vt-layout\">\n          <!-- Left: Player & VoiceTube Controls -->\n          <div class=\"vt-media-box\">\n            <div class=\"video-frame-container\">\n              <div class=\"audio-poster\">\n                <div class=\"audio-poster-icon\">🎙️</div>\n                <h3 id=\"current-lesson-title\">載入中...</h3>\n                <span id=\"current-lesson-subtitle\">VoiceTube Interactive Masterclass</span>\n              </div>\n            </div>\n\n            <!-- VoiceTube Action Buttons -->\n            <div class=\"vt-controls-bar\">\n              <!-- 核心：播放全文 / 連續自動朗讀 (讓英文跑起來！) -->\n              <button class=\"vt-btn vt-play-btn-prominent\" id=\"vt-play-all-btn\" title=\"開始逐句自動朗讀全文\">\n                <span id=\"vt-play-all-icon\">▶</span> <span id=\"vt-play-all-text\">開始全文朗讀 (英文跑起來)</span>\n              </button>\n\n              <!-- 循環重複按鈕 (放大加粗) -->\n              <button class=\"vt-btn player-pill-control\" id=\"vt-repeat-sentence-btn\" title=\"單句重複練習模式\">\n                <span>🔂 單句重複: <b id=\"vt-single-repeat-status\">關</b></span>\n              </button>\n              <button class=\"vt-btn player-pill-control active-loop\" id=\"vt-loop-article-btn\" title=\"課文循環播放\">\n                <span>🔁 全課循環: <b id=\"vt-all-loop-status\">開</b></span>\n              </button>\n\n              <button class=\"vt-btn\" id=\"vt-speed-btn\" title=\"調整朗讀語速\">\n                <span id=\"speed-indicator\">⚡ 1.0x</span>\n              </button>\n              <button class=\"vt-btn active\" id=\"vt-toggle-zh-btn\" title=\"切換中英對照\">\n                <span>雙語字幕</span>\n              </button>\n              <button class=\"vt-btn\" id=\"vt-jump-prev-btn\">⏮️ 上一句</button>\n              <button class=\"vt-btn\" id=\"vt-jump-next-btn\">下一句 ⏭️</button>\n            </div>\n\n            <!-- Shadowing Section -->\n            <div class=\"shadowing-box\">\n              <div class=\"shadowing-top\">\n                <h4>🎙️ 影子跟讀 (Shadowing) 即時口說評測</h4>\n                <span class=\"match-badge\" id=\"shadow-score\">等待朗讀</span>\n              </div>\n              <div class=\"shadowing-act\">\n                <button class=\"record-btn\" id=\"vt-record-btn\">\n                  <span>🎤 開始跟讀</span>\n                </button>\n                <div class=\"shadowing-transcript\" id=\"shadow-result\">\n                  點選句子後，按住麥克風跟讀原句...\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Right: Interactive Subtitle Stream -->\n          <div class=\"vt-subtitles-card\">\n            <div class=\"subtitles-header\">\n              <h3><span>📜</span> 互動字幕（點擊單字即查即存生字卡）</h3>\n              <small style=\"color: var(--sp-light-gray);\">選取字詞立即收錄例句</small>\n            </div>\n            <div class=\"subtitles-scroll\" id=\"subtitles-container\">\n              <!-- Dynamically populated -->\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- PANE 2: FLASHCARDS REVIEW (生字卡 3D 翻面模式) -->\n      <section id=\"flashcards-view\" class=\"view-pane\">\n        <div class=\"flashcard-view-wrapper\">\n          <div class=\"fc-header-box\">\n            <div>\n              <h1 style=\"font-size: 26px; font-weight: 800;\">📇 智慧生字卡複習 (Flashcard Mode)</h1>\n              <p style=\"color: var(--sp-light-gray); font-size: 13px; margin-top: 4px;\">Anki 雙面翻卡記憶法，包含您在文章中點選的字詞與自動關聯的原句例句。</p>\n            </div>\n            <div class=\"fc-progress-pill\" id=\"fc-progress-display\">\n              進度: 0 / 0\n            </div>\n          </div>\n\n          <!-- 3D Flip Card -->\n          <div class=\"fc-scene\">\n            <div class=\"fc-card\" id=\"active-fc-card\">\n              <!-- FRONT -->\n              <div class=\"fc-face fc-front\">\n                <span class=\"fc-badge\">FRONT 正面 (單字)</span>\n                <div class=\"fc-front-content\">\n                  <div class=\"fc-word\" id=\"fc-word-front\">Shrinkflation</div>\n                  <div class=\"fc-ipa\" id=\"fc-ipa-front\">/ˈʃrɪŋk.fleɪ.ʃən/</div>\n                  <button class=\"vt-btn\" id=\"fc-speak-word-btn\" style=\"margin-top: 10px;\">🔊 朗讀發音</button>\n                </div>\n                <div class=\"fc-hint\">\n                  <span>🔄 點擊卡片或按「空白鍵」翻面查看例句與釋義</span>\n                </div>\n              </div>\n\n              <!-- BACK -->\n              <div class=\"fc-face fc-back\">\n                <span class=\"fc-badge\" style=\"background: rgba(99, 102, 241, 0.2); color: #818cf8;\">BACK 背面 (釋義與原句例句)</span>\n                <div class=\"fc-back-meaning\" id=\"fc-meaning-back\">\n                  【名】縮水式通膨（售價維持不變，但包裝或份量實質縮小）\n                </div>\n                \n                <div class=\"fc-example-card\">\n                  <div class=\"fc-example-label\">📌 文章原句例句 (Context Example)：</div>\n                  <div class=\"fc-example-en\" id=\"fc-example-en-back\">\n                    \"<b>Shrinkflation</b> occurs when the price of a product remains the same, but the packaging size gets smaller.\"\n                  </div>\n                  <div class=\"fc-example-zh\" id=\"fc-example-zh-back\">\n                    縮水式通膨是指產品價格保持不變，但包裝份量卻變小了。\n                  </div>\n                </div>\n\n                <div class=\"fc-audio-group\">\n                  <button class=\"vt-btn\" id=\"fc-speak-example-btn\">🔊 朗讀例句</button>\n                  <button class=\"vt-btn\" id=\"fc-speak-word-back-btn\">🔊 朗讀單字</button>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Controls Bar -->\n          <div class=\"fc-controls-bar\">\n            <button class=\"fc-btn fc-btn-next\" id=\"fc-prev-btn\">⏮️ 上一張</button>\n            <button class=\"fc-btn fc-btn-flip\" id=\"fc-flip-btn\">🔄 翻轉卡片</button>\n            <button class=\"fc-btn fc-btn-master\" id=\"fc-master-btn\">✅ 標記已掌握</button>\n            <button class=\"fc-btn fc-btn-next\" id=\"fc-next-btn\">下一張 ⏭️</button>\n          </div>\n        </div>\n      </section>\n\n      <!-- PANE 3: SPOTIFY MUSIC LOUNGE (GOOGLE DRIVE 音樂資料庫) -->\n      <section id=\"music-view\" class=\"view-pane\">\n        <div class=\"sp-hero\">\n          <h1 id=\"greeting-text\">Good Evening, oscarmark</h1>\n          <p>Google Drive 專屬雲端音樂庫 ＆ Spotify 質感沉浸播放館。</p>\n        </div>\n\n        <!-- Folder Category Filter for Spotify Music -->\n        <div class=\"folder-pills-row\" id=\"music-folder-pills\" style=\"margin-bottom: 12px;\">\n          <button class=\"folder-pill active\" data-music-folder=\"all\">🎵 全部歌曲 (<span id=\"music-count-all\">0</span>)</button>\n          <button class=\"folder-pill\" data-music-folder=\"Englishvoice\">📘 Englishvoice (<span id=\"music-count-ev\">0</span>)</button>\n          <button class=\"folder-pill kline-pill\" data-music-folder=\"KLine\">📈 KLine (<span id=\"music-count-kline\">0</span>)</button>\n        </div>\n\n        <!-- Toolbar: Search & Queue Controls -->\n        <div class=\"sp-table-toolbar\">\n          <div class=\"sp-search-box\">\n            <span>🔍</span>\n            <input type=\"text\" id=\"music-search-input\" placeholder=\"在 73 首雲端音樂中搜尋歌曲名稱...\">\n          </div>\n          <div class=\"sp-view-toggle-btns\">\n            <button class=\"vt-btn\" id=\"reset-order-btn\" title=\"按住每首歌曲左側 ⠿ 即可上下拖曳自訂順序，點此可恢復雲端預設排序\" style=\"font-size: 12px; border-radius: 20px; padding: 6px 14px;\">\n              🔄 重設排序\n            </button>\n            <button class=\"vt-btn gold\" id=\"toggle-queue-btn\" style=\"font-weight: 700; border-radius: 20px; padding: 8px 18px;\">\n              📜 現正播放清單 (Playing List)\n            </button>\n            <span style=\"font-size: 12px; color: var(--sp-light-gray);\">🖐️ 按住 ⠿ 拖曳自訂播放順序</span>\n          </div>\n        </div>\n\n        <!-- 播放清單抽屜 (Playing List Queue Drawer) -->\n        <div class=\"queue-drawer\" id=\"queue-drawer\">\n          <div class=\"queue-header\">\n            <div class=\"queue-title\">📜 現正播放清單 (Playing List & Queue)</div>\n            <button class=\"vt-btn\" id=\"close-queue-btn\" style=\"padding: 4px 10px; font-size: 12px;\">關閉清單 ✕</button>\n          </div>\n          <div class=\"queue-list\" id=\"queue-list-container\">\n            <!-- Dynamically populated -->\n          </div>\n        </div>\n\n        <!-- 詳細列表 (Detailed Track Table) -->\n        <div class=\"sp-table-wrap\">\n          <table class=\"sp-track-table\">\n            <thead>\n              <tr>\n                <th class=\"track-num-cell\">#</th>\n                <th>歌曲名稱 (Track Title)</th>\n                <th>來源 (Storage)</th>\n                <th class=\"track-badge-cell\">播放狀態</th>\n                <th class=\"track-action-cell\">操作</th>\n              </tr>\n            </thead>\n            <tbody id=\"drive-music-table-body\">\n              <!-- Dynamically populated rows -->\n            </tbody>\n          </table>\n        </div>\n\n        <!-- Spotify Synchronized Lyrics Mode -->\n        <div class=\"sp-lyrics-section\">\n          <div class=\"sp-lyrics-title\">\n            <span>🎤 Spotify 動態同步即時歌詞 (Live Lyrics)</span>\n            <span style=\"font-size: 13px; color: var(--sp-green); font-weight: 600;\">LRC Auto-Scroll</span>\n          </div>\n          <div class=\"sp-lyrics-scroll\" id=\"sp-lyrics-box\">\n            <!-- Rendered dynamically -->\n          </div>\n        </div>\n      </section>\n\n      <!-- PANE 4: VOCABULARY VAULT -->\n      <section id=\"vault-view\" class=\"view-pane\">\n        <div class=\"vault-header\">\n          <div>\n            <h1 style=\"font-size: 26px; font-weight: 800;\">⭐ 生詞資料庫 (Vocabulary Vault)</h1>\n            <p style=\"color: var(--sp-light-gray); font-size: 13px; margin-top: 4px;\">所有在文章中收錄的生字卡清單與例句彙整。</p>\n          </div>\n          <div style=\"display: flex; gap: 10px;\">\n            <button class=\"vt-btn\" id=\"export-csv-btn\">匯出 Anki CSV</button>\n            <button class=\"vt-btn\" id=\"clear-vault-btn\" style=\"color: var(--danger);\">清空生詞</bu