er);\n      padding: 10px 16px;\n      border-radius: 20px;\n      font-size: 13px;\n      font-weight: 600;\n      cursor: pointer;\n    }\n    .dict-btn-save {\n      flex: 1;\n      background: var(--sp-green);\n      color: #000;\n      border: none;\n      padding: 10px 16px;\n      border-radius: 20px;\n      font-size: 13px;\n      font-weight: 700;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 6px;\n    }\n    .dict-btn-save:hover {\n      background: var(--sp-green-hover);\n    }\n\n    .popup-backdrop {\n      position: fixed;\n      inset: 0;\n      background: rgba(0, 0, 0, 0.75);\n      backdrop-filter: blur(4px);\n      z-index: 999;\n      display: none;\n    }\n\n    /* ==================== 4. SPOTIFY MUSIC LOUNGE ==================== */\n    .sp-hero { margin-bottom: 24px; }\n    .sp-hero h1 { font-size: 30px; font-weight: 800; margin-bottom: 6px; }\n    .sp-hero p { color: var(--sp-light-gray); font-size: 14px; }\n    .sp-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));\n      gap: 20px;\n      margin-bottom: 30px;\n    }\n    .sp-card {\n      background: var(--sp-dark-gray);\n      border-radius: 10px;\n      padding: 14px;\n      transition: var(--transition);\n      cursor: pointer;\n      position: relative;\n    }\n    .sp-card:hover { background: var(--sp-card-gray); transform: translateY(-4px); }\n    .sp-card-img-wrap {\n      width: 100%;\n      aspect-ratio: 1;\n      border-radius: 8px;\n      overflow: hidden;\n      margin-bottom: 12px;\n      position: relative;\n      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);\n      background: #111;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .sp-card-img { width: 100%; height: 100%; object-fit: cover; }\n    .sp-card-play {\n      position: absolute;\n      bottom: 10px;\n      right: 10px;\n      width: 44px;\n      height: 44px;\n      border-radius: 50%;\n      background: var(--sp-green);\n      color: #000;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 20px;\n      opacity: 0;\n      transform: translateY(8px);\n      transition: var(--transition);\n      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);\n    }\n    .sp-card:hover .sp-card-play { opacity: 1; transform: translateY(0); }\n    .sp-card-title { font-size: 14px; font-weight: 700; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    .sp-card-desc { font-size: 12px; color: var(--sp-light-gray); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4; }\n\n    .sp-lyrics-section {\n      background: #18281e;\n      border-radius: 16px;\n      padding: 24px;\n      display: flex;\n      flex-direction: column;\n      height: 450px;\n      overflow: hidden;\n      border: 1px solid var(--sp-border);\n    }\n    .sp-lyrics-title { font-size: 18px; font-weight: 800; margin-bottom: 16px; display: flex; justify-content: space-between; }\n    .sp-lyrics-scroll { flex: 1; overflow-y: auto; padding: 20px 0; display: flex; flex-direction: column; gap: 18px; scroll-behavior: smooth; }\n    .sp-lrc-line { font-size: 20px; font-weight: 700; color: rgba(255, 255, 255, 0.35); transition: var(--transition); cursor: pointer; line-height: 1.5; }\n    .sp-lrc-line:hover { color: rgba(255, 255, 255, 0.7); }\n    .sp-lrc-line.active { font-size: 26px; color: #ffffff; transform: scale(1.02); transform-origin: left center; }\n\n    /* ==================== 5. VOCABULARY VAULT ==================== */\n    .vault-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }\n    .vault-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }\n    .vault-card {\n      background: var(--sp-dark-gray);\n      border: 1px solid var(--sp-border);\n      border-radius: 12px;\n      padding: 16px;\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      transition: var(--transition);\n    }\n    .vault-card:hover { background: var(--sp-card-gray); border-color: rgba(255, 255, 255, 0.15); }\n    .vault-top { display: flex; justify-content: space-between; align-items: center; }\n    .vault-word { font-size: 20px; font-weight: 800; color: var(--vt-gold); }\n    .vault-phonetic { font-family: var(--font-mono); font-size: 12px; color: var(--sp-light-gray); }\n    .vault-meaning { font-size: 13px; line-height: 1.5; color: #e2e8f0; }\n    .vault-ctx { font-size: 12px; color: var(--sp-light-gray); font-style: italic; border-left: 2px solid var(--sp-green); padding-left: 8px; }\n\n    /* ==================== BOTTOM SPOTIFY BAR ==================== */\n    .bottom-bar {\n      grid-column: 1 / -1;\n      background-color: var(--sp-dark-gray);\n      border-top: 1px solid var(--sp-border);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 24px;\n      z-index: 100;\n    }\n    .bar-left { display: flex; align-items: center; gap: 14px; width: 280px; min-width: 180px; }\n    .bar-cover { width: 56px; height: 56px; border-radius: 6px; object-fit: cover; }\n    .bar-meta { display: flex; flex-direction: column; gap: 2px; overflow: hidden; }\n    .bar-title { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    .bar-artist { font-size: 12px; color: var(--sp-light-gray); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    .heart-btn { background: transparent; border: none; color: var(--sp-light-gray); font-size: 18px; cursor: pointer; }\n    .heart-btn.liked { color: var(--sp-green); }\n    .bar-center { flex: 1; max-width: 650px; display: flex; flex-direction: column; align-items: center; gap: 6px; }\n    .center-buttons { display: flex; align-items: center; gap: 18px; }\n    .player-btn { background: transparent; border: none; color: var(--sp-light-gray); font-size: 16px; cursor: pointer; transition: var(--transition); }\n    .player-btn:hover { color: var(--sp-white); transform: scale(1.1); }\n    .player-btn.play-circle { width: 38px; height: 38px; background: var(--sp-white); color: #000; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; }\n    .player-btn.play-circle:hover { background: var(--sp-green); transform: scale(1.08); }\n    .playback-bar { width: 100%; display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; color: var(--sp-light-gray); }\n    .progress-track { flex: 1; height: 4px; background: rgba(255, 255, 255, 0.2); border-radius: 4px; position: relative; cursor: pointer; }\n    .progress-track:hover { height: 6px; }\n    .progress-fill { height: 100%; background: var(--sp-white); border-radius: 4px; width: 0%; transition: width 0.1s linear; }\n    .progress-track:hover .progress-fill { background: var(--sp-green); }\n    .bar-right { display: flex; align-items: center; gap: 14px; width: 240px; justify-content: flex-end; }\n    .vol-slider { width: 90px; accent-color: var(--sp-green); cursor: pointer; }\n\n    @media (max-width: 900px) {\n      .app-shell { grid-template-columns: 1fr; }\n      .sidebar { display: none; }\n      .vt-layout { grid-template-columns: 1fr; }\n    }\n  \n    /* ==================== 4.1 SPOTIFY DETAILED TRACK TABLE ==================== */\n    .sp-table-toolbar {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin: 18px 0 14px 0;\n      flex-wrap: wrap;\n      gap: 12px;\n    }\n    .sp-search-box {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      background: rgba(255, 255, 255, 0.08);\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      border-radius: 20px;\n      padding: 6px 14px;\n      width: 280px;\n    }\n    .sp-search-box input {\n      background: transparent;\n      border: none;\n      outline: none;\n      color: #fff;\n      font-size: 13px;\n      width: 100%;\n    }\n    .sp-view-toggle-btns {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n    .sp-table-wrap {\n      background: rgba(18, 18, 18, 0.6);\n      border: 1px solid var(--sp-border);\n      border-radius: 12px;\n      overflow: hidden;\n      margin-bottom: 24px;\n    }\n    .sp-track-table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 13.5px;\n    }\n    .sp-track-table th {\n      padding: 12px 16px;\n      text-align: left;\n      font-size: 11.5px;\n      font-weight: 700;\n      color: var(--sp-light-gray);\n      text-transform: uppercase;\n      letter-spacing: 0.8px;\n      border-bottom: 1px solid var(--sp-border);\n      background: rgba(255, 255, 255, 0.03);\n    }\n    .sp-track-row {\n      cursor: pointer;\n      transition: background 0.15s ease;\n      border-bottom: 1px solid rgba(255, 255, 255, 0.04);\n    }\n    .sp-track-row:hover {\n      background: rgba(255, 255, 255, 0.08);\n    }\n    .sp-track-row.active {\n      background: rgba(29, 185, 84, 0.15);\n      color: var(--sp-green);\n      font-weight: 700;\n    }\n    .sp-track-row td {\n      padding: 12px 16px;\n      vertical-align: middle;\n    }\n    .track-num-cell {\n      width: 44px;\n      text-align: center;\n      font-family: var(--font-mono);\n      color: var(--sp-light-gray);\n      font-size: 13px;\n    }\n    .sp-track-row.active .track-num-cell {\n      color: var(--sp-green);\n    }\n    .track-title-cell {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      font-weight: 600;\n      color: #fff;\n    }\n    .sp-track-row.active .track-title-cell {\n      color: var(--sp-green);\n    }\n    .track-icon-disk {\n      font-size: 16px;\n      opacity: 0.8;\n    }\n    .track-source-cell {\n      color: var(--sp-light-gray);\n      font-size: 12px;\n    }\n    .track-badge-cell {\n      text-align: center;\n    }\n    .track-status-pill {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      padding: 3px 10px;\n      border-radius: 12px;\n      font-size: 11px;\n      font-weight: 700;\n      background: rgba(255, 255, 255, 0.06);\n      color: var(--sp-light-gray);\n    }\n    .track-status-pill.playing {\n      background: var(--sp-green);\n      color: #000;\n      box-shadow: 0 0 10px var(--sp-green-glow);\n    }\n    .track-action-cell {\n      text-align: right;\n    }\n    .row-play-btn {\n      background: transparent;\n      border: none;\n      color: var(--sp-light-gray);\n      font-size: 16px;\n      cursor: pointer;\n      padding: 4px 8px;\n      transition: transform 0.15s, color 0.15s;\n    }\n    .row-play-btn:hover {\n      color: var(--sp-green);\n      transform: scale(1.2);\n    }\n\n    /* ==================== 4.2 PLAYING LIST (QUEUE DRAWER) ==================== */\n    .queue-drawer {\n      display: none;\n      background: #181818;\n      border: 1px solid var(--sp-border);\n      border-radius: 14px;\n      padding: 18px;\n      margin-bottom: 24px;\n      animation: fadeIn 0.2s ease;\n    }\n    .queue-drawer.show {\n      display: block;\n    }\n    .queue-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 14px;\n      border-bottom: 1px solid var(--sp-border);\n      padding-bottom: 10px;\n    }\n    .queue-title {\n      font-size: 16px;\n      font-weight: 800;\n      color: var(--vt-gold);\n    }\n    .queue-list {\n      max-height: 280px;\n      overflow-y: auto;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n    }\n    .queue-item {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 8px 12px;\n      background: rgba(255, 255, 255, 0.03);\n      border-radius: 8px;\n      cursor: pointer;\n      font-size: 13px;\n      transition: background 0.15s;\n    }\n    .queue-item:hover {\n      background: rgba(255, 255, 255, 0.08);\n    }\n    .queue-item.current {\n      background: rgba(29, 185, 84, 0.15);\n      border-left: 3px solid var(--sp-green);\n      color: var(--sp-green);\n      font-weight: 700;\n    }\n\n    /* ==================== 4.3 ENLARGED LOOP & REPEAT BUTTONS ==================== */\n    .player-pill-control {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      padding: 8px 16px !important;\n      border-radius: 24px !important;\n      font-size: 13px !important;\n      font-weight: 700 !important;\n      background: rgba(255, 255, 255, 0.08) !important;\n      border: 1px solid rgba(255, 255, 255, 0.2) !important;\n      color: var(--sp-light-gray) !important;\n      cursor: pointer;\n      transition: all 0.2s cubic-bezier(0.3, 0, 0.2, 1) !important;\n    }\n    .player-pill-control:hover {\n      background: rgba(255, 255, 255, 0.15) !important;\n      color: #fff !important;\n      transform: scale(1.05);\n    }\n    .player-pill-control.active-loop {\n      background: rgba(29, 185, 84, 0.2) !important;\n      border-color: var(--sp-green) !important;\n      color: var(--sp-green) !important;\n      box-shadow: 0 0 12px var(--sp-green-glow);\n    }\n    .player-pill-control.active-repeat {\n      background: rgba(245, 158, 11, 0.2) !important;\n      border-color: var(--vt-gold) !important;\n      color: var(--vt-gold) !important;\n      box-shadow: 0 0 12px rgba(245, 158, 11, 0.3);\n    }\n\n    /* ==================== 4.4 VOICETUBE AUTO-READING STYLES ==================== */\n    .sub-row.speaking {\n      border: 2px solid var(--sp-green) !important;\n      background: rgba(29, 185, 84, 0.12) !important;\n      box-shadow: 0 0 16px var(--sp-green-glow);\n      transform: scale(1.01);\n    }\n    .sub-row.speaking .sub-time {\n      color: var(--sp-green);\n      font-weight: 800;\n    }\n    .vt-play-btn-prominent {\n      background: var(--sp-green) !important;\n      color: #000 !important;\n      font-weight: 800 !important;\n      font-size: 14px !important;\n      padding: 10px 20px !important;\n      border-radius: 24px !important;\n      box-shadow: 0 4px 15px var(--sp-green-glow) !important;\n      transition: all 0.2s !important;\n    }\n    .vt-play-btn-prominent:hover {\n      background: var(--sp-green-hover) !important;\n      transform: scale(1.05) !important;\n    }\n    .vt-play-btn-prominent.reading {\n      background: #ef4444 !important;\n      color: #fff !important;\n      box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4) !important;\n    }\n\n  </style>\n</head>\n<body>\n\n  <!-- Backdrop for Modals -->\n  <div id=\"dict-backdrop\" class=\"popup-backdrop\"></div>\n\n  <!-- Floating Selection Tooltip -->\n  <div id=\"selection-tooltip\">\u2795 \u5b58\u70ba\u751f\u5b57\u5361</div>\n\n  <!-- VoiceTube Click-to-Translate & Add to Flashcard Modal -->\n  <div id=\"dict-popup\" class=\"vt-dict-popup\">\n    <div class=\"dict-header\">\n      <div>\n        <div class=\"dict-word-title\" id=\"dict-title\">Shrinkflation</div>\n        <div class=\"dict-phonetic\" id=\"dict-phonetic\">/\u02c8\u0283r\u026a\u014bk.fle\u026a.\u0283\u0259n/</div>\n      </div>\n      <button class=\"dict-close\" id=\"dict-close-btn\">\u2715</button>\n    </div>\n    <div class=\"dict-body\">\n      <div class=\"dict-meaning\" id=\"dict-meaning\">\n        \u3010\u540d\u3011\u7e2e\u6c34\u5f0f\u901a\u81a8\uff08\u552e\u50f9\u7dad\u6301\u4e0d\u8b8a\uff0c\u4f46\u5305\u88dd\u6216\u4efd\u91cf\u5be6\u8cea\u7e2e\u5c0f\uff09\n      </div>\n      <div class=\"dict-example-preview\">\n        <div class=\"dict-example-label\">\ud83d\udccc \u81ea\u52d5\u6536\u9304\u6587\u7ae0\u539f\u53e5\u70ba\u4f8b\u53e5\uff1a</div>\n        <div class=\"dict-context\" id=\"dict-context\">\n          \u201cShrinkflation occurs when the price of a product remains the same...\u201d\n        </div>\n      </div>\n    </div>\n    <div class=\"dict-actions\">\n      <button class=\"dict-btn-voice\" id=\"dict-voice-btn\">\ud83d\udd0a \u55ae\u5b57\u767c\u97f3</button>\n      <button class=\"dict-btn-save\" id=\"dict-save-btn\">\n        <span>\ud83d\udcc7 \u5b58\u70ba\u751f\u5b57\u5361 (\u542b\u4f8b\u53e5)</span>\n      </button>\n    </div>\n  </div>\n\n  <!-- App Shell -->\n  <div class=\"app-shell\">\n\n    <!-- ==================== SIDEBAR ==================== -->\n    <aside class=\"sidebar\">\n      <div class=\"brand-logo\">\n        <div class=\"brand-logo-icon\">\ud83c\udfa7</div>\n        <div>\n          <div class=\"brand-name\">OSCARMARK</div>\n          <div class=\"brand-sub\">Studio Pro</div>\n        </div>\n      </div>\n\n      <nav class=\"nav-group\">\n        <div class=\"nav-label\">\u4e3b\u8981\u6a21\u5f0f</div>\n        <button class=\"nav-item active\" data-view=\"english-view\">\n          <span class=\"nav-icon\">\ud83d\udcda</span>\n          <span>VoiceTube \u82f1\u8a9e\u7cbe\u8b80</span>\n        </button>\n        <button class=\"nav-item\" data-view=\"flashcards-view\">\n          <span class=\"nav-icon\">\ud83d\udcc7</span>\n          <span>\u751f\u5b57\u5361\u8907\u7fd2 (<span id=\"sidebar-fc-count\">0</span>)</span>\n        </button>\n        <button class=\"nav-item\" data-view=\"music-view\">\n          <span class=\"nav-icon\">\ud83c\udfb5</span>\n          <span>Spotify \u97f3\u6a02\u9928 (<span id=\"sidebar-music-count\">0</span>)</span>\n        </button>\n        <button class=\"nav-item\" data-view=\"vault-view\">\n          <span class=\"nav-icon\">\u2b50</span>\n          <span>\u751f\u8a5e\u8cc7\u6599\u5eab</span>\n        </button>\n      </nav>\n\n      <div class=\"sidebar-divider\"></div>\n\n      <!-- Drive Sync Status -->\n      <div class=\"drive-status-card\">\n        <h4>\u2601\ufe0f Google \u96f2\u7aef\u786c\u789f\u5eab</h4>\n        <p id=\"drive-stats-text\">\u6b63\u5728\u8b80\u53d6\u96f2\u7aef\u8cc7\u6599\u5eab...</p>\n        <button class=\"vt-btn\" id=\"refresh-drive-btn\" style=\"padding: 4px 8px; font-size: 11px;\">\ud83d\udd04 \u91cd\u65b0\u6383\u63cf\u96f2\u7aef</button>\n      </div>\n\n      <div class=\"sidebar-ambient-card\">\n        <h4>\ud83c\udf27\ufe0f \u5c08\u6ce8\u767d\u566a\u97f3\u4f34\u8b80</h4>\n        <p>\u5728\u5b78\u7fd2\u6216\u807d\u6b4c\u6642\u758a\u52a0\u81ea\u7136\u96e8\u8072\u8207\u5496\u5561\u9928\u74b0\u5883\u97f3\u3002</p>\n        <button class=\"ambient-open-btn\" id=\"ambient-toggle-btn\">\u958b\u555f\u6df7\u97f3\u5668</button>\n      </div>\n    </aside>\n\n    <!-- ==================== MAIN VIEWPORT ==================== -->\n    <main class=\"main-view\">\n\n      <!-- PANE 1: VOICETUBE ENGLISH HUB -->\n      <section id=\"english-view\" class=\"view-pane active\">\n        <div class=\"vt-header\">\n          <div class=\"vt-title-box\">\n            <h1>\ud83d\udcda VoiceTube \u6c89\u6d78\u5f0f\u82f1\u8a9e\u5b78\u7fd2</h1>\n            <p>\u9ede\u9078\u6587\u7ae0\u55ae\u5b57\u6216\u6ed1\u9f20\u5708\u9078\u7247\u8a9e\uff0c\u81ea\u52d5\u5c07\u55ae\u5b57\u8207<strong>\u7576\u524d\u53e5\u5b50\u6536\u9304\u70ba\u751f\u5b57\u5361\u8207\u4f8b\u53e5</strong>\u3002</p>\n          </div>\n          <div class=\"vt-lesson-picker\">\n            <select class=\"vt-select\" id=\"lesson-selector\">\n              <option value=\"\">\u6b63\u5728\u6383\u63cf\u96f2\u7aef\u6587\u7ae0\u5eab...</option>\n            </select>\n            <button class=\"vt-btn\" id=\"toggle-drawer-btn\">\ud83d\udcdd \u8cbc\u4e0a\u65b0\u6587\u7ae0</button>\n            <button class=\"vt-btn gold\" id=\"jump-to-fc-btn\">\ud83d\udcc7 \u67e5\u770b\u751f\u5b57\u5361</button>\n          </div>\n        </div>\n\n        <!-- Article Input / Save Drawer -->\n        <div class=\"article-drawer\" id=\"article-drawer\">\n          <textarea id=\"raw-article-input\" placeholder=\"\u8acb\u5728\u6b64\u8cbc\u4e0a\u82f1\u6587\u6587\u7ae0\u5167\u5bb9...\"></textarea>\n          <div class=\"drawer-actions\">\n            <input type=\"text\" id=\"article-save-name\" class=\"drawer-input\" placeholder=\"\u5132\u5b58\u81f3 Google Drive \u7684\u6a94\u540d (\u4f8b\u5982: Lesson_04)\">\n            <button class=\"vt-btn active\" id=\"parse-article-btn\">\u89e3\u6790\u4e26\u7ffb\u8b6f\u6587\u7ae0</button>\n            <button class=\"vt-btn\" id=\"save-article-drive-btn\">\u5132\u5b58\u5230\u96f2\u7aef\u786c\u789f</button>\n          </div>\n        </div>\n\n        <div class=\"vt-layout\">\n          <!-- Left: Player & VoiceTube Controls -->\n          <div class=\"vt-media-box\">\n            <div class=\"video-frame-container\">\n              <div class=\"audio-poster\">\n                <div class=\"audio-poster-icon\">\ud83c\udf99\ufe0f</div>\n                <h3 id=\"current-lesson-title\">\u8f09\u5165\u4e2d...</h3>\n                <span id=\"current-lesson-subtitle\">VoiceTube Interactive Masterclass</span>\n              </div>\n            </div>\n\n            <!-- VoiceTube Action Buttons -->\n            <div class=\"vt-controls-bar\">\n              <!-- \u6838\u5fc3\uff1a\u64ad\u653e\u5168\u6587 / \u9023\u7e8c\u81ea\u52d5\u6717\u8b80 (\u8b93\u82f1\u6587\u8dd1\u8d77\u4f86\uff01) -->\n              <button class=\"vt-btn vt-play-btn-prominent\" id=\"vt-play-all-btn\" title=\"\u958b\u59cb\u9010\u53e5\u81ea\u52d5\u6717\u8b80\u5168\u6587\">\n                <span id=\"vt-play-all-icon\">\u25b6</span> <span id=\"vt-play-all-text\">\u958b\u59cb\u5168\u6587\u6717\u8b80 (\u82f1\u6587\u8dd1\u8d77\u4f86)</span>\n              </button>\n\n              <!-- \u5faa\u74b0\u91cd\u8907\u6309\u9215 (\u653e\u5927\u52a0\u7c97) -->\n              <button class=\"vt-btn player-pill-control\" id=\"vt-repeat-sentence-btn\" title=\"\u55ae\u53e5\u91cd\u8907\u7df4\u7fd2\u6a21\u5f0f\">\n                <span>\ud83d\udd02 \u55ae\u53e5\u91cd\u8907: <b id=\"vt-single-repeat-status\">\u95dc</b></span>\n              </button>\n              <button class=\"vt-btn player-pill-control active-loop\" id=\"vt-loop-article-btn\" title=\"\u8ab2\u6587\u5faa\u74b0\u64ad\u653e\">\n                <span>\ud83d\udd01 \u5168\u8ab2\u5faa\u74b0: <b id=\"vt-all-loop-status\">\u958b</b></span>\n              </button>\n\n              <button class=\"vt-btn\" id=\"vt-speed-btn\" title=\"\u8abf\u6574\u6717\u8b80\u8a9e\u901f\">\n                <span id=\"speed-indicator\">\u26a1 1.0x</span>\n              </button>\n              <button class=\"vt-btn active\" id=\"vt-toggle-zh-btn\" title=\"\u5207\u63db\u4e2d\u82f1\u5c0d\u7167\">\n                <span>\u96d9\u8a9e\u5b57\u5e55</span>\n              </button>\n              <button class=\"vt-btn\" id=\"vt-jump-prev-btn\">\u23ee\ufe0f \u4e0a\u4e00\u53e5</button>\n              <button class=\"vt-btn\" id=\"vt-jump-next-btn\">\u4e0b\u4e00\u53e5 \u23ed\ufe0f</button>\n            </div>\n\n            <!-- Shadowing Section -->\n            <div class=\"shadowing-box\">\n              <div class=\"shadowing-top\">\n                <h4>\ud83c\udf99\ufe0f \u5f71\u5b50\u8ddf\u8b80 (Shadowing) \u5373\u6642\u53e3\u8aaa\u8a55\u6e2c</h4>\n                <span class=\"match-badge\" id=\"shadow-score\">\u7b49\u5f85\u6717\u8b80</span>\n              </div>\n              <div class=\"shadowing-act\">\n                <button class=\"record-btn\" id=\"vt-record-btn\">\n                  <span>\ud83c\udfa4 \u958b\u59cb\u8ddf\u8b80</span>\n                </button>\n                <div class=\"shadowing-transcript\" id=\"shadow-result\">\n                  \u9ede\u9078\u53e5\u5b50\u5f8c\uff0c\u6309\u4f4f\u9ea5\u514b\u98a8\u8ddf\u8b80\u539f\u53e5...\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Right: Interactive Subtitle Stream -->\n          <div class=\"vt-subtitles-card\">\n            <div class=\"subtitles-header\">\n              <h3><span>\ud83d\udcdc</span> \u4e92\u52d5\u5b57\u5e55\uff08\u9ede\u64ca\u55ae\u5b57\u5373\u67e5\u5373\u5b58\u751f\u5b57\u5361\uff09</h3>\n              <small style=\"color: var(--sp-light-gray);\">\u9078\u53d6\u5b57\u8a5e\u7acb\u5373\u6536\u9304\u4f8b\u53e5</small>\n            </div>\n            <div class=\"subtitles-scroll\" id=\"subtitles-container\">\n              <!-- Dynamically populated -->\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- PANE 2: FLASHCARDS REVIEW (\u751f\u5b57\u5361 3D \u7ffb\u9762\u6a21\u5f0f) -->\n      <section id=\"flashcards-view\" class=\"view-pane\">\n        <div class=\"flashcard-view-wrapper\">\n          <div class=\"fc-header-box\">\n            <div>\n              <h1 style=\"font-size: 26px; font-weight: 800;\">\ud83d\udcc7 \u667a\u6167\u751f\u5b57\u5361\u8907\u7fd2 (Flashcard Mode)</h1>\n              <p style=\"color: var(--sp-light-gray); font-size: 13px; margin-top: 4px;\">Anki \u96d9\u9762\u7ffb\u5361\u8a18\u61b6\u6cd5\uff0c\u5305\u542b\u60a8\u5728\u6587\u7ae0\u4e2d\u9ede\u9078\u7684\u5b57\u8a5e\u8207\u81ea\u52d5\u95dc\u806f\u7684\u539f\u53e5\u4f8b\u53e5\u3002</p>\n            </div>\n            <div class=\"fc-progress-pill\" id=\"fc-progress-display\">\n              \u9032\u5ea6: 0 / 0\n            </div>\n          </div>\n\n          <!-- 3D Flip Card -->\n          <div class=\"fc-scene\">\n            <div class=\"fc-card\" id=\"active-fc-card\">\n              <!-- FRONT -->\n              <div class=\"fc-face fc-front\">\n                <span class=\"fc-badge\">FRONT \u6b63\u9762 (\u55ae\u5b57)</span>\n                <div class=\"fc-front-content\">\n                  <div class=\"fc-word\" id=\"fc-word-front\">Shrinkflation</div>\n                  <div class=\"fc-ipa\" id=\"fc-ipa-front\">/\u02c8\u0283r\u026a\u014bk.fle\u026a.\u0283\u0259n/</div>\n                  <button class=\"vt-btn\" id=\"fc-speak-word-btn\" style=\"margin-top: 10px;\">\ud83d\udd0a \u6717\u8b80\u767c\u97f3</button>\n                </div>\n                <div class=\"fc-hint\">\n                  <span>\ud83d\udd04 \u9ede\u64ca\u5361\u7247\u6216\u6309\u300c\u7a7a\u767d\u9375\u300d\u7ffb\u9762\u67e5\u770b\u4f8b\u53e5\u8207\u91cb\u7fa9</span>\n                </div>\n              </div>\n\n              <!-- BACK -->\n              <div class=\"fc-face fc-back\">\n                <span class=\"fc-badge\" style=\"background: rgba(99, 102, 241, 0.2); color: #818cf8;\">BACK \u80cc\u9762 (\u91cb\u7fa9\u8207\u539f\u53e5\u4f8b\u53e5)</span>\n                <div class=\"fc-back-meaning\" id=\"fc-meaning-back\">\n                  \u3010\u540d\u3011\u7e2e\u6c34\u5f0f\u901a\u81a8\uff08\u552e\u50f9\u7dad\u6301\u4e0d\u8b8a\uff0c\u4f46\u5305\u88dd\u6216\u4efd\u91cf\u5be6\u8cea\u7e2e\u5c0f\uff09\n                </div>\n                \n                <div class=\"fc-example-card\">\n                  <div class=\"fc-example-label\">\ud83d\udccc \u6587\u7ae0\u539f\u53e5\u4f8b\u53e5 (Context Example)\uff1a</div>\n                  <div class=\"fc-example-en\" id=\"fc-example-en-back\">\n                    \"<b>Shrinkflation</b> occurs when the price of a product remains the same, but the packaging size gets smaller.\"\n                  </div>\n                  <div class=\"fc-example-zh\" id=\"fc-example-zh-back\">\n                    \u7e2e\u6c34\u5f0f\u901a\u81a8\u662f\u6307\u7522\u54c1\u50f9\u683c\u4fdd\u6301\u4e0d\u8b8a\uff0c\u4f46\u5305\u88dd\u4efd\u91cf\u537b\u8b8a\u5c0f\u4e86\u3002\n                  </div>\n                </div>\n\n                <div class=\"fc-audio-group\">\n                  <button class=\"vt-btn\" id=\"fc-speak-example-btn\">\ud83d\udd0a \u6717\u8b80\u4f8b\u53e5</button>\n                  <button class=\"vt-btn\" id=\"fc-speak-word-back-btn\">\ud83d\udd0a \u6717\u8b80\u55ae\u5b57</button>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Controls Bar -->\n          <div class=\"fc-controls-bar\">\n            <button class=\"fc-btn fc-btn-next\" id=\"fc-prev-btn\">\u23ee\ufe0f \u4e0a\u4e00\u5f35</button>\n            <button class=\"fc-btn fc-btn-flip\" id=\"fc-flip-btn\">\ud83d\udd04 \u7ffb\u8f49\u5361\u7247</button>\n            <button class=\"fc-btn fc-btn-master\" id=\"fc-master-btn\">\u2705 \u6a19\u8a18\u5df2\u638c\u63e1</button>\n            <button class=\"fc-btn fc-btn-next\" id=\"fc-next-btn\">\u4e0b\u4e00\u5f35 \u23ed\ufe0f</button>\n          </div>\n        </div>\n      </section>\n\n      <!-- PANE 3: SPOTIFY MUSIC LOUNGE (GOOGLE DRIVE \u97f3\u6a02\u8cc7\u6599\u5eab) -->\n      <section id=\"music-view\" class=\"view-pane\">\n        <div class=\"sp-hero\">\n          <h1 id=\"greeting-text\">Good Evening, oscarmark</h1>\n          <p>Google Drive \u5c08\u5c6c\u96f2\u7aef\u97f3\u6a02\u5eab \uff06 Spotify \u8cea\u611f\u6c89\u6d78\u64ad\u653e\u9928\u3002</p>\n        </div>\n\n        <!-- Toolbar: Search & Queue Controls -->\n        <div class=\"sp-table-toolbar\">\n          <div class=\"sp-search-box\">\n            <span>\ud83d\udd0d</span>\n            <input type=\"text\" id=\"music-search-input\" placeholder=\"\u5728 73 \u9996\u96f2\u7aef\u97f3\u6a02\u4e2d\u641c\u5c0b\u6b4c\u66f2\u540d\u7a31...\">\n          </div>\n          <div class=\"sp-view-toggle-btns\">\n            <button class=\"vt-btn gold\" id=\"toggle-queue-btn\" style=\"font-weight: 700; border-radius: 20px; padding: 8px 18px;\">\n              \ud83d\udcdc \u73fe\u6b63\u64ad\u653e\u6e05\u55ae (Playing List)\n            </button>\n            <span style=\"font-size: 13px; color: var(--sp-light-gray);\">\u4e00\u5f8b\u63a1\u7528\u8a73\u7d30\u5217\u8868\u6a21\u5f0f</span>\n          </div>\n        </div>\n\n        <!-- \u64ad\u653e\u6e05\u55ae\u62bd\u5c5c (Playing List Queue Drawer) -->\n        <div class=\"queue-drawer\" id=\"queue-drawer\">\n          <div class=\"queue-header\">\n            <div class=\"queue-title\">\ud83d\udcdc \u73fe\u6b63\u64ad\u653e\u6e05\u55ae (Playing List & Queue)</div>\n            <button class=\"vt-btn\" id=\"close-queue-btn\" style=\"padding: 4px 10px; font-size: 12px;\">\u95dc\u9589\u6e05\u55ae \u2715</button>\n          </div>\n          <div class=\"queue-list\" id=\"queue-list-container\">\n            <!-- Dynamically populated -->\n          </div>\n        </div>\n\n        <!-- \u8a73\u7d30\u5217\u8868 (Detailed Track Table) -->\n        <div class=\"sp-table-wrap\">\n          <table class=\"sp-track-table\">\n            <thead>\n              <tr>\n                <th class=\"track-num-cell\">#</th>\n                <th>\u6b4c\u66f2\u540d\u7a31 (Track Title)</th>\n                <th>\u4f86\u6e90 (Storage)</th>\n                <th class=\"track-badge-cell\">\u64ad\u653e\u72c0\u614b</th>\n                <th class=\"track-action-cell\">\u64cd\u4f5c</th>\n              </tr>\n            </thead>\n            <tbody id=\"drive-music-table-body\">\n              <!-- Dynamically populated rows -->\n            </tbody>\n          </table>\n        </div>\n\n        <!-- Spotify Synchronized Lyrics Mode -->\n        <div class=\"sp-lyrics-section\">\n          <div class=\"sp-lyrics-title\">\n            <span>\ud83c\udfa4 Spotify \u52d5\u614b\u540c\u6b65\u5373\u6642\u6b4c\u8a5e (Live Lyrics)</span>\n            <span style=\"font-size: 13px; color: var(--sp-green); font-weight: 600;\">LRC Auto-Scroll</span>\n          </div>\n          <div class=\"sp-lyrics-scroll\" id=\"sp-lyrics-box\">\n            <!-- Rendered dynamically -->\n          </div>\n        </div>\n      </section>\n\n      <!-- PANE 4: VOCABULARY VAULT -->\n      <section id=\"vault-view\" class=\"view-pane\">\n        <div class=\"vault-header\">\n          <div>\n            <h1 style=\"font-size: 26px; font-weight: 800;\">\u2b50 \u751f\u8a5e\u8cc7\u6599\u5eab (Vocabulary Vault)</h1>\n            <p style=\"color: var(--sp-light-gray); font-size: 13px; margin-top: 4px;\">\u6240\u6709\u5728\u6587\u7ae0\u4e2d\u6536\u9304\u7684\u751f\u5b57\u5361\u6e05\u55ae\u8207\u4f8b\u53e5\u5f59\u6574\u3002</p>\n          </div>\n          <div style=\"display: flex; gap: 10px;\">\n            <button class=\"vt-btn\" id=\"export-csv-btn\">\u532f\u51fa Anki CSV</button>\n            <button class=\"vt-btn\" id=\"clear-vault-btn\" style=\"color: var(--danger);\">\u6e05\u7a7a\u751f\u8a5e</button>\n          </div>\n        </div>\n\n        <div class=\"vault-grid\" id=\"vault-items-grid\">\n          <!-- Rendered dynamically -->\n        </div>\n      </section>\n\n    </main>\n\n    <!-- ==================== BOTTOM SPOTIFY BAR ==================== -->\n    <footer class=\"bottom-bar\">\n      <div class=\"bar-left\">\n        <img class=\"bar-cover\" id=\"bar-cover-img\" src=\"https://images.unsplash.com/photo-1518495973542-4542c06a5843?w=300&auto=format&fit=crop\" alt=\"Cover\">\n        <div class=\"bar-meta\">\n          <div class=\"bar-title\" id=\"bar-title-text\">\u6b63\u5728\u9023\u7dda\u96f2\u7aef\u8cc7\u6599\u5eab...</div>\n          <div class=\"bar-artist\" id=\"bar-artist-text\">OSCARMARK2007</div>\n        </div>\n        <button class=\"heart-btn\" id=\"like-btn\" title=\"\u6536\u85cf\u6b4c\u66f2\">\ud83d\udc9a</button>\n      </div>\n\n      <div class=\"bar-center\">\n        <div class=\"center-buttons\" style=\"gap: 14px;\">\n          <!-- \u5de1\u74b0\u6309\u9215 (\u653e\u5927\u986f\u773c\uff0c\u5207\u63db\u5168\u90e8\u5faa\u74b0 / \u96a8\u6a5f\u64ad\u653e / \u9806\u5e8f\u64ad\u653e) -->\n          <button class=\"player-pill-control active-loop\" id=\"player-loop-pill\" title=\"\u9ede\u64ca\u5207\u63db\u5faa\u74b0\u6a21\u5f0f\">\n            <span id=\"player-loop-icon\" style=\"font-size: 16px;\">\ud83d\udd01</span>\n            <span id=\"player-loop-text\">\u5168\u90e8\u5faa\u74b0</span>\n          </button>\n\n          <button class=\"player-btn\" id=\"player-prev\" title=\"\u4e0a\u4e00\u66f2 / \u4e0a\u4e00\u53e5\" style=\"font-size: 20px;\">\u23ee</button>\n          <button class=\"player-btn play-circle\" id=\"player-play\" title=\"\u64ad\u653e / \u66ab\u505c\" style=\"width: 44px; height: 44px; font-size: 20px;\">\u25b6</button>\n          <button class=\"player-btn\" id=\"player-next\" title=\"\u4e0b\u4e00\u66f2 / \u4e0b\u4e00\u53e5\" style=\"font-size: 20px;\">\u23ed</button>\n\n          <!-- \u5c08\u5c6c\u91cd\u8907\u6309\u9215 (\u653e\u5927\u986f\u773c\uff0c\u55ae\u66f2\u5faa\u74b0) -->\n          <button class=\"player-pill-control\" id=\"player-repeat-pill\" title=\"\u9ede\u64ca\u5207\u63db\u55ae\u66f2\u91cd\u8907\">\n            <span id=\"player-repeat-icon\" style=\"font-size: 16px;\">\ud83d\udd02</span>\n            <span id=\"player-repeat-text\">\u55ae\u66f2\u91cd\u8907: \u95dc</span>\n          </button>\n        </div>\n        <div class=\"playback-bar\">\n          <span id=\"time-current\">00:00</span>\n          <div class=\"progress-track\" id=\"bar-progress-track\">\n            <div class=\"progress-fill\" id=\"bar-progress-fill\"></div>\n          </div>\n          <span id=\"time-duration\">00:00</span>\n        </div>\n      </div>\n\n      <div class=\"bar-right\">\n        <span style=\"font-size: 16px; cursor: pointer;\" title=\"\u52d5\u614b\u6b4c\u8a5e\">\ud83c\udfa4</span>\n        <span style=\"font-size: 16px; cursor: pointer;\">\ud83d\udd0a</span>\n        <input type=\"range\" class=\"vol-slider\" id=\"bar-volume\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.85\">\n      </div>\n    </footer>\n\n  </div>\n\n  <!-- Audio Player -->\n  <audio id=\"core-audio\" preload=\"metadata\"></audio>\n\n  <!-- ==================== APPLICATION SCRIPTS ==================== -->\n  <script>\n    // Fallback Sample Lessons for standalone / GitHub Pages mode\n    const FALLBACK_LESSONS = {\n      'sample-1': {\n        title: 'Mixed Conditionals & Modern Business',\n        artist: 'VoiceTube Masterclass',\n        audio: 'https://actions.google.com/sounds/v1/ambiences/coffee_shop.ogg',\n        sentences: [\n          {\n            start: 0, end: 5.2,\n            en: \"Shrinkflation occurs when the price of a product remains the same, but the packaging size gets smaller.\",\n            zh: \"\u7e2e\u6c34\u5f0f\u901a\u81a8\u662f\u6307\u7522\u54c1\u50f9\u683c\u4fdd\u6301\u4e0d\u8b8a\uff0c\u4f46\u5305\u88dd\u4efd\u91cf\u537b\u8b8a\u5c0f\u4e86\uff08\u7e2e\u6c34\uff0b\u901a\u81a8\uff09\u3002\"\n          },\n          {\n            start: 5.3, end: 11.5,\n            en: \"Skimpflation happens when a company uses cheaper ingredients to make the same product in order to keep the price steady.\",\n            zh: \"\u5077\u5de5\u6e1b\u6599\u578b\u901a\u81a8\u662f\u6307\u4f01\u696d\u70ba\u4e86\u7dad\u6301\u50f9\u683c\uff0c\u6539\u7528\u66f4\u5ec9\u50f9\u7684\u539f\u6599\u4f86\u88fd\u9020\u76f8\u540c\u7522\u54c1\u3002\"\n          },\n          {\n            start: 11.6, end: 18.2,\n            en: \"Greedflation describes when corporations raise prices excessively under the guise of general inflation to boost profits.\",\n            zh: \"\u8caa\u5a6a\u901a\u81a8\u5247\u63cf\u8ff0\u4f01\u696d\u85c9\u53e3\u6574\u9ad4\u7269\u50f9\u901a\u81a8\uff0c\u8d81\u6a5f\u904e\u5ea6\u54c4\u62ac\u50f9\u683c\u4ee5\u64f4\u5927\u5229\u6f64\u3002\"\n          },\n          {\n            start: 18.3, end: 25.8,\n            en: \"If consumers had been more vigilant, companies would not be employing these deceptive pricing tactics today.\",\n            zh: \"\u5982\u679c\u6d88\u8cbb\u8005\u7576\u521d\u66f4\u52a0\u8b66\u60d5\uff0c\u4f01\u696d\u4eca\u5929\u5c31\u4e0d\u6703\u63a1\u7528\u9019\u4e9b\u6b3a\u9a19\u6027\u7684\u5b9a\u50f9\u7b56\u7565\u3002\"\n          }\n        ]\n      }\n    };\n\n    const QUICK_DICT = {\n      'shrinkflation': { ipa: '/\u02c8\u0283r\u026a\u014bk.fle\u026a.\u0283\u0259n/', meaning: '\u3010\u540d\u3011\u7e2e\u6c34\u5f0f\u901a\u81a8\uff08\u552e\u50f9\u7dad\u6301\u4e0d\u8b8a\uff0c\u4f46\u5305\u88dd\u6216\u4efd\u91cf\u5be6\u8cea\u7e2e\u5c0f\uff09' },\n      'skimpflation': { ipa: '/\u02c8sk\u026amp.fle\u026a.\u0283\u0259n/', meaning: '\u3010\u540d\u3011\u5077\u5de5\u6e1b\u6599\u578b\u901a\u81a8\uff08\u552e\u50f9\u7dad\u6301\u4e0d\u8b8a\uff0c\u4f46\u6539\u7528\u5ec9\u50f9\u4f4e\u52a3\u539f\u6599\u88fd\u9020\uff09' },\n      'greedflation': { ipa: '/\u02c8\u0261ri\u02d0d.fle\u026a.\u0283\u0259n/', meaning: '\u3010\u540d\u3011\u8caa\u5a6a\u901a\u81a8\uff08\u4f01\u696d\u4ee5\u6574\u9ad4\u901a\u81a8\u70ba\u85c9\u53e3\u60e1\u610f\u904e\u5ea6\u54c4\u62ac\u50f9\u683c\uff09' },\n      'vigilant': { ipa: '/\u02c8v\u026ad\u0292.\u0259l.\u0259nt/', meaning: '\u3010\u5f62\u3011\u8b66\u60d5\u7684\u3001\u8b66\u89ba\u7684' },\n      'deceptive': { ipa: '/d\u026a\u02c8sep.t\u026av/', meaning: '\u3010\u5f62\u3011\u6b3a\u9a19\u6027\u7684\u3001\u4ee4\u4eba\u8aa4\u89e3\u7684' },\n      'tactics': { ipa: '/\u02c8t\u00e6k.t\u026aks/', meaning: '\u3010\u540d\u3011\u6230\u8853\u3001\u7b56\u7565\u624b\u6bb5' },\n      'nuances': { ipa: '/\u02c8nju\u02d0.\u0251\u02d0ns\u026az/', meaning: '\u3010\u540d\u3011\u7d30\u5fae\u5dee\u5225\u3001\u7cbe\u5999\u4e4b\u8655' },\n      'empowers': { ipa: '/\u026am\u02c8pa\u028a.\u0259rz/', meaning: '\u3010\u52d5\u3011\u4f7f\u80fd\u5920\u3001\u8ce6\u4e88\u529b\u91cf' },\n      'articulate': { ipa: '/\u0251\u02d0\u02c8t\u026ak.j\u0259.l\u0259t/', meaning: '\u3010\u52d5\u3011\u6e05\u6670\u95e1\u660e\u3001\u8868\u9054\uff1b\u3010\u5f62\u3011\u54ac\u5b57\u6e05\u6670\u7684' }\n    };\n\n    class AppManager {\n      constructor() {\n        this.audio = document.getElementById('core-audio');\n        this.currentMode = 'english';\n        this.activeSentenceIndex = 0;\n        this.isLoopingSentence = false;\n        this.playbackSpeed = 1.0;\n        this.showChinese = true;\n        this.vocab = [];\n        this.activeFcIndex = 0;\n\n        // Drive Data Store\n        this.driveAudios = [];\n        this.driveArticles = [];\n        this.currentArticleSentences = [];\n        this.currentAudioIndex = 0;\n\n        // Auto-Reading & Loop States\n        this.isPlayingAllSentences = false;\n        this.isLoopingSentence = false;\n        this.isLoopingArticle = true;\n        this.loopMode = 'all'; // 'all', 'shuffle', 'seq'\n        this.singleRepeat = false;\n        this.musicFilterKeyword = '';\n\n        this.initDOM();\n        this.initEvents();\n        this.loadVocabFromStorage();\n        this.loadDriveAssets();\n      }\n\n      initDOM() {\n        this.navItems = document.querySelectorAll('.nav-item');\n        this.viewPanes = document.querySelectorAll('.view-pane');\n        \n        // Bottom Player\n        this.playBtn = document.getElementById('player-play');\n        this.prevBtn = document.getElementById('player-prev');\n        this.nextBtn = document.getElementById('player-next');\n        this.barProgressTrack = document.getElementById('bar-progress-track');\n        this.barProgressFill = document.getElementById('bar-progress-fill');\n        this.timeCurrent = document.getElementById('time-current');\n        this.timeDuration = document.getElementById('time-duration');\n        this.barCover = document.getElementById('bar-cover-img');\n        this.barTitle = document.getElementById('bar-title-text');\n        this.barArtist = document.getElementById('bar-artist-text');\n        this.barVolume = document.getElementById('bar-volume');\n\n        // VoiceTube Controls\n        this.lessonSelector = document.getElementById('lesson-selector');\n        this.subtitlesContainer = document.getElementById('subtitles-container');\n        this.currentLessonTitle = document.getElementById('current-lesson-title');\n        this.vtRepeatBtn = document.getElementById('vt-repeat-sentence-btn');\n        this.vtSpeedBtn = document.getElementById('vt-speed-btn');\n        this.speedIndicator = document.getElementById('speed-indicator');\n        this.vtToggleZhBtn = document.getElementById('vt-toggle-zh-btn');\n        this.vtJumpPrevBtn = document.getElementById('vt-jump-prev-btn');\n        this.vtJumpNextBtn = document.getElementById('vt-jump-next-btn');\n        this.jumpToFcBtn = document.getElementById('jump-to-fc-btn');\n\n        // Drawer\n        this.toggleDrawerBtn = document.getElementById('toggle-drawer-btn');\n        this.articleDrawer = document.getElementById('article-drawer');\n        this.rawArticleInput = document.getElementById('raw-article-input');\n        this.articleSaveName = document.getElementById('article-save-name');\n        this.parseArticleBtn = document.getElementById('parse-article-btn');\n        this.saveArticleDriveBtn = document.getElementById('save-article-drive-btn');\n\n        // Shadowing\n        this.recordBtn = document.getElementById('vt-record-btn');\n        this.shadowScore = document.getElementById('shadow-score');\n        this.shadowResult = document.getElementById('shadow-result');\n\n        // Tooltip & Popups\n        this.selectionTooltip = document.getElementById('selection-tooltip');\n        this.dictPopup = document.getElementById('dict-popup');\n        this.dictBackdrop = document.getElementById('dict-backdrop');\n        this.dictCloseBtn = document.getElementById('dict-close-btn');\n        this.dictTitle = document.getElementById('dict-title');\n        this.dictPhonetic = document.getElementById('dict-phonetic');\n        this.dictMeaning = document.getElementById('dict-meaning');\n        this.dictContext = document.getElementById('dict-context');\n        this.dictVoiceBtn = document.getElementById('dict-voice-btn');\n        this.dictSaveBtn = document.getElementById('dict-save-btn');\n\n        // Flashcards\n        this.activeFcCard = document.getElementById('active-fc-card');\n        this.fcProgressDisplay = document.getElementById('fc-progress-display');\n        this.fcWordFront = document.getElementById('fc-word-front');\n        this.fcIpaFront = document.getElementById('fc-ipa-front');\n        this.fcMeaningBack = document.getElementById('fc-meaning-back');\n        this.fcExampleEnBack = document.getElementById('fc-example-en-back');\n        this.fcExampleZhBack = document.getElementById('fc-example-zh-back');\n        this.fcSpeakWordBtn = document.getElementById('fc-speak-word-btn');\n        this.fcSpeakWordBackBtn = document.getElementById('fc-speak-word-back-btn');\n        this.fcSpeakExampleBtn = document.getElementById('fc-speak-example-btn');\n        this.fcPrevBtn = document.getElementById('fc-prev-btn');\n        this.fcNextBtn = document.getElementById('fc-next-btn');\n        this.fcFlipBtn = document.getElementById('fc-flip-btn');\n        this.fcMasterBtn = document.getElementById('fc-master-btn');\n\n        // Vault & Drive Status\n        this.vaultGrid = document.getElementById('vault-items-grid');\n        this.sidebarFcCount = document.getElementById('sidebar-fc-count');\n        this.sidebarMusicCount = document.getElementById('sidebar-music-count');\n        this.driveStatsText = document.getElementById('drive-stats-text');\n        this.refreshDriveBtn = document.getElementById('refresh-drive-btn');\n        this.driveMusicGrid = document.getElementById('drive-music-grid');\n\n        // VoiceTube New Auto-Play Elements\n        this.vtPlayAllBtn = document.getElementById('vt-play-all-btn');\n        this.vtPlayAllIcon = document.getElementById('vt-play-all-icon');\n        this.vtPlayAllText = document.getElementById('vt-play-all-text');\n        this.vtSingleRepeatStatus = document.getElementById('vt-single-repeat-status');\n        this.vtLoopArticleBtn = document.getElementById('vt-loop-article-btn');\n        this.vtAllLoopStatus = document.getElementById('vt-all-loop-status');\n\n        // Detailed Music Table & Queue Elements\n        this.musicTableBody = document.getElementById('drive-music-table-body');\n        this.musicSearchInput = document.getElementById('music-search-input');\n        this.toggleQueueBtn = document.getElementById('toggle-queue-btn');\n        this.closeQueueBtn = document.getElementById('close-queue-btn');\n        this.queueDrawer = document.getElementById('queue-drawer');\n        this.queueListContainer = document.getElementById('queue-list-container');\n\n        // Enlarged Bottom Bar Loop & Repeat Controls\n        this.playerLoopPill = document.getElementById('player-loop-pill');\n        this.playerLoopIcon = document.getElementById('player-loop-icon');\n        this.playerLoopText = document.getElementById('player-loop-text');\n        this.playerRepeatPill = document.getElementById('player-repeat-pill');\n        this.playerRepeatIcon = document.getElementById('player-repeat-icon');\n        this.playerRepeatText = document.getElementById('player-repeat-text');\n      }\n\n      initEvents() {\n        this.navItems.forEach((btn) => {\n          btn.addEventListener('click', () => this.switchView(btn.getAttribute('data-view')));\n        });\n        this.jumpToFcBtn.addEventListener('click', () => this.switchView('flashcards-view'));\n\n        // Bottom Player\n        this.audio.addEventListener('timeupdate', () => this.onTimeUpdate());\n        this.audio.addEventListener('play', () => { this.playBtn.textContent = '\u23f8'; });\n        this.audio.addEventListener('pause', () => { this.playBtn.textContent = '\u25b6'; });\n        this.audio.addEventListener('loadedmetadata', () => {\n          this.timeDuration.textContent = this.formatTime(this.audio.duration || 0);\n        });\n\n        this.playBtn.addEventListener('click', () => {\n          if (this.audio.paused) this.audio.play(); else this.audio.pause();\n        });\n\n        this.barProgressTrack.addEventListener('click', (e) => {\n          const rect = this.barProgressTrack.getBoundingClientRect();\n          const pos = (e.clientX - rect.left) / rect.width;\n          if (this.audio.duration) this.audio.currentTime = pos * this.audio.duration;\n        });\n\n        this.barVolume.addEventListener('input', (e) => {\n          this.audio.volume = parseFloat(e.target.value);\n        });\n\n        // Drawer\n        this.toggleDrawerBtn.addEventListener('click', () => {\n          this.articleDrawer.classList.toggle('active');\n        });\n\n        this.parseArticleBtn.addEventListener('click', () => {\n          const raw = this.rawArticleInput.value.trim();\n          if (!raw) return alert('\u8acb\u5148\u8cbc\u4e0a\u82f1\u6587\u6587\u7ae0\u5167\u5bb9\uff01');\n          this.parseAndRenderRawArticle(raw);\n          this.articleDrawer.classList.remove('active');\n        });\n\n        this.saveArticleDriveBtn.addEventListener('click', () => {\n          this.saveArticleToCloud();\n        });\n\n        // Refresh Drive\n        this.refreshDriveBtn.addEventListener('click', () => {\n          this.loadDriveAssets();\n        });\n\n        // Article selection\n        this.lessonSelector.addEventListener('change', (e) => {\n          const val = e.target.value;\n          if (val.startsWith('drive_art_')) {\n            const idx = parseInt(val.replace('drive_art_', ''));\n            const art = this.driveArticles[idx];\n            if (art) {\n              this.currentLessonTitle.textContent = art.name;\n              this.rawArticleInput.value = art.content;\n              this.articleSaveName.value = art.name;\n              this.parseAndRenderRawArticle(art.content);\n            }\n          } else if (val === 'sample-1') {\n            this.renderSampleLesson('sample-1');\n          }\n        });\n\n        // Loop / Speed / Jumps\n        this.vtRepeatBtn.addEventListener('click', () => {\n          this.isLoopingSentence = !this.isLoopingSentence;\n          this.vtRepeatBtn.classList.toggle('active', this.isLoopingSentence);\n          this.updateLoopTag();\n        });\n\n        this.vtSpeedBtn.addEventListener('click', () => {\n          const speeds = [0.75, 0.9, 1.0, 1.25];\n          let idx = speeds.indexOf(this.playbackSpeed);\n          idx = (idx + 1) % speeds.length;\n          this.playbackSpeed = speeds[idx];\n          this.audio.playbackRate = this.playbackSpeed;\n          this.speedIndicator.textContent = `\ud83d\udc22 ${this.playbackSpeed}x`;\n        });\n\n        this.vtToggleZhBtn.addEventListener('click', () => {\n          this.showChinese = !this.showChinese;\n          this.vtToggleZhBtn.classList.toggle('active', this.showChinese);\n          document.querySelectorAll('.sub-zh').forEach((el) => {\n            el.style.display = this.showChinese ? 'block' : 'none';\n          });\n        });\n\n        this.vtJumpPrevBtn.addEventListener('click', () => this.jumpSentence(-1));\n        this.vtJumpNextBtn.addEventListener('click', () => this.jumpSentence(1));\n\n        // VoiceTube Auto-Play & Loop Listeners\n        if (this.vtPlayAllBtn) {\n          this.vtPlayAllBtn.addEventListener('click', () => this.togglePlayAllSentences());\n        }\n        if (this.vtRepeatBtn) {\n          this.vtRepeatBtn.addEventListener('click', () => this.toggleSingleRepeatSentence());\n        }\n        if (this.vtLoopArticleBtn) {\n          this.vtLoopArticleBtn.addEventListener('click', () => this.toggleLoopArticle());\n        }\n\n        // Music Detailed Table & Queue Listeners\n        if (this.musicSearchInput) {\n          this.musicSearchInput.addEventListener('input', (e) => {\n            this.musicFilterKeyword = e.target.value.trim().toLowerCase();\n            this.renderSpotifyMusicTable();\n          });\n        }\n        if (this.toggleQueueBtn) {\n          this.toggleQueueBtn.addEventListener('click', () => this.toggleQueueDrawer());\n        }\n        if (this.closeQueueBtn) {\n          this.closeQueueBtn.addEventListener('click', () => {\n            this.queueDrawer.classList.remove('show');\n          });\n        }\n\n        // Enlarged Loop & Repeat Listeners\n        if (this.playerLoopPill) {\n          this.playerLoopPill.addEventListener('click', () => this.cycleMusicLoopMode());\n        }\n        if (this.playerRepeatPill) {\n          this.playerRepeatPill.addEventListener('click', () => this.toggleMusicSingleRepeat());\n        }\n\n        // Audio Ended Event (Auto-advance next song)\n        this.audio.addEventListener('ended', () => this.handleAudioEnded());\n\n        // Previous & Next Song / Sentence Router\n        if (this.prevBtn) {\n          this.prevBtn.addEventListener('click', () => this.handlePrevAction());\n        }\n        if (this.nextBtn) {\n          this.nextBtn.addEventListener('click', () => this.handleNextAction());\n        }\n        this.prevBtn.addEventListener('click', () => this.jumpSentence(-1));\n        this.nextBtn.addEventListener('click', () => this.jumpSentence(1));\n\n        // Popups\n        this.dictCloseBtn.addEventListener('click', () => this.closeDict());\n        this.dictBackdrop.addEventListener('click', () => this.closeDict());\n        this.dictVoiceBtn.addEventListener('click', () => this.speak(this.dictTitle.textContent));\n\n        this.dictSaveBtn.addEventListener('click', () => {\n          const item = {\n            word: this.dictTitle.textContent,\n            phonetic: this.dictPhonetic.textContent,\n            meaning: this.dictMeaning.textContent,\n            example_en: this.currentExampleEn || this.dictContext.textContent,\n            example_zh: this.currentExampleZh || ''\n          };\n          this.saveWord(item);\n        });\n\n        this.initTextSelection();\n\n        // Flashcards 3D\n        this.activeFcCard.addEventListener('click', () => this.flipFlashcard());\n        this.fcFlipBtn.addEventListener('click', () => this.flipFlashcard());\n        this.fcPrevBtn.addEventListener('click', () => this.jumpFlashcard(-1));\n        this.fcNextBtn.addEventListener('click', () => this.jumpFlashcard(1));\n        this.fcMasterBtn.addEventListener('click', () => this.toggleMasterActiveCard());\n\n        this.fcSpeakWordBtn.addEventListener('click', (e) => {\n          e.stopPropagation();\n          this.speak(this.fcWordFront.textContent);\n        });\n        this.fcSpeakWordBackBtn.addEventListener('click', (e) => {\n          e.stopPropagation();\n          this.speak(this.fcWordFront.textContent);\n        });\n        this.fcSpeakExampleBtn.addEventListener('click', (e) => {\n          e.stopPropagation();\n          const cleanText = this.fcExampleEnBack.textContent.replace(/[\"\u201d]/g, '');\n          this.speak(cleanText);\n        });\n\n        window.addEventListener('keydown', (e) => {\n          if (e.code === 'Space' && document.getElementById('flashcards-view').classList.contains('active')) {\n            e.preventDefault();\n            this.flipFlashcard();\n          }\n        });\n\n        this.initShadowing();\n        document.getElementById('export-csv-btn').addEventListener('click', () => this.exportAnkiCSV());\n        document.getElementById('clear-vault-btn').addEventListener('click', () => {\n          if (confirm('\u78ba\u5b9a\u8981\u6e05\u7a7a\u6240\u6709\u6536\u85cf\u7684\u751f\u5b57\u5361\u55ce\uff1f')) {\n            this.vocab = [];\n            this.syncVocabToStorage();\n            this.renderVault();\n            this.renderFlashcard();\n          }\n        });\n      }\n\n      switchView(viewId) {\n        this.navItems.forEach((b) => b.classList.toggle('active', b.getAttribute('data-view') === viewId));\n        this.viewPanes.forEach((p) => p.classList.remove('active'));\n        document.getElementById(viewId).classList.add('active');\n\n        if (viewId === 'flashcards-view') this.renderFlashcard();\n        if (viewId === 'vault-view') this.renderVault();\n      }\n\n      // ==================== GOOGLE DRIVE ASSET LOADER ====================\n\n      loadDriveAssets() {\n        this.driveStatsText.textContent = '\u23f3 \u6b63\u5728\u6383\u63cf\u96f2\u7aef\u786c\u789f (ID: 132cXw...)...';\n\n        if (typeof google !== 'undefined' && google.script && google.script.run) {\n          google.script.run\n            .withSuccessHandler((assets) => {\n              this.handleLoadedAssets(assets);\n            })\n            .withFailureHandler((err) => {\n              this.driveStatsText.textContent = '\u26a0\ufe0f \u96f2\u7aef\u8b80\u53d6\u7570\u5e38\uff0c\u5207\u63db\u81f3\u672c\u6a5f\u5099\u7528\u5eab';\n              this.renderSampleLesson('sample-1');\n            })\n            .getFolderAssets();\n        } else {\n          // GitHub Pages mode / Local Preview mode\n          this.driveStatsText.textContent = '\u2601\ufe0f \u96f2\u7aef\u5df2\u9023\u7dda (\u5099\u4efd\u793a\u7bc4\u5eab\u5df2\u555f\u52d5)';\n          this.handleLoadedAssets({\n            audios: [\n              { name: 'Rainy Night Lofi Study.mp3', id: 'sample_rain', url: 'https://actions.google.com/sounds/v1/weather/gentle_rain.ogg' },\n              { name: 'Warm Coffee Shop Acoustic.mp3', id: 'sample_cafe', url: 'https://actions.google.com/sounds/v1/ambiences/coffee_shop.ogg' },\n              { name: 'Forest Birds Meditation.mp3', id: 'sample_forest', url: 'https://actions.google.com/sounds/v1/ambiences/outdoor_morning.ogg' }\n            ],\n            articles: [\n              { name: '01. Mixed Conditionals & Modern Business', content: \"Shrinkflation occurs when the price of a product remains the same, but the packaging size gets smaller.\\nSkimpflation happens when a company uses cheaper ingredients to make the same product.\\nGreedflation describes when corporations raise prices excessively under the guise of general inflation.\" }\n            ]\n          });\n        }\n      }\n\n      handleLoadedAssets(assets) {\n        this.driveAudios = assets.audios || [];\n        this.driveArticles = assets.articles || [];\n\n        this.driveStatsText.textContent = `\u2705 \u96f2\u7aef\u786c\u789f\uff1a${this.driveAudios.length} \u9996\u97f3\u6a02 / ${this.driveArticles.length} \u7bc7\u6559\u6750`;\n        this.sidebarMusicCount.textContent = this.driveAudios.length;\n\n        // \u66f4\u65b0\u5e95\u90e8\u64ad\u653e\u5217\u63d0\u793a\u72c0\u614b\n        if (this.driveAudios.length > 0) {\n          this.barTitle.textContent = `\ud83c\udfb5 \u96f2\u7aef\u97f3\u6a02\u5df2\u5c31\u7dd2 (\u5171 ${this.driveAudios.length} \u9996)`;\n          this.barArtist.textContent = '\u9ede\u64ca\u5de6\u5074\u300cSpotify \u97f3\u6a02\u9928\u300d\u6311\u9078\u6b4c\u66f2\u64ad\u653e';\n        }\n\n        // Populate Lesson Selector\n        this.lessonSelector.innerHTML = '';\n        if (this.driveArticles.length > 0) {\n          this.driveArticles.forEach((art, i) => {\n            const opt = document.createElement('option');\n            opt.value = `drive_art_${i}`;\n            opt.textContent = `\ud83d\udcc4 ${art.name}`;\n            this.lessonSelector.appendChild(opt);\n          });\n          // Auto load first article\n          this.currentLessonTitle.textContent = this.driveArticles[0].name;\n          this.parseAndRenderRawArticle(this.driveArticles[0].content);\n        } else {\n          const opt = document.createElement('option');\n          opt.value = 'sample-1';\n          opt.textContent = '01. Mixed Conditionals (\u793a\u7bc4\u6559\u6750)';\n          this.lessonSelector.appendChild(opt);\n          this.renderSampleLesson('sample-1');\n        }\n\n        // Populate Spotify Music Grid\n        this.renderSpotifyMusicGrid();\n      }\n\n      renderSpotifyMusicGrid() {\n        // Alias to Detailed Table\n        this.renderSpotifyMusicTable();\n      }\n\n      renderSpotifyMusicTable() {\n        if (!this.musicTableBody) return;\n        this.musicTableBody.innerHTML = '';\n\n        const filter = (this.musicFilterKeyword || '').toLowerCase();\n        let displayCount = 0;\n\n        this.driveAudios.forEach((audio, idx) => {\n          if (filter && !audio.name.toLowerCase().includes(filter)) {\n            return;\n          }\n          displayCount++;\n\n          const isCurrent = (idx === this.currentAudioIndex && !this.audio.paused);\n          const tr = document.createElement('tr');\n          tr.className = `sp-track-row ${idx === this.currentAudioIndex ? 'active' : ''}`;\n          tr.innerHTML = `\n            <td class=\"track-num-cell\">\n              ${isCurrent ? '<span style=\"color:var(--sp-green); animation: pulse 1s infinite;\">\ud83d\udd0a</span>' : (idx + 1)}\n            </td>\n            <td>\n              <div class=\"track-title-cell\">\n                <span class=\"track-icon-disk\">\ud83c\udfb5</span>\n                <span>${audio.name}</span>\n              </div>\n            </td>\n            <td class=\"track-source-cell\">\n              \ud83d\udcc1 Google Drive \u96f2\u7aef\u5c08\u5c6c\u97f3\u6a02\n            </td>\n            <td class=\"track-badge-cell\">\n              <span class=\"track-status-pill ${isCurrent ? 'playing' : ''}\">\n                ${isCurrent ? '\ud83d\udfe2 \u64ad\u653e\u4e2d' : '\u26aa \u5f85\u64ad'}\n              </span>\n            </td>\n            <td class=\"track-action-cell\">\n              <button class=\"row-play-btn\" title=\"\u64ad\u653e\u6b64\u6b4c\u66f2\">${isCurrent ? '\u23f8' : '\u25b6'}</button>\n            </td>\n          `;\n\n          tr.addEventListener('click', () => {\n            this.playDriveAudio(idx);\n          });\n\n          this.musicTableBody.appendChild(tr);\n        });\n\n        // Also update Queue Drawer if open\n        this.renderQueueDrawerList();\n      }\n\n      toggleQueueDrawer() {\n        if (!this.queueDrawer) return;\n        this.queueDrawer.classList.toggle('show');\n        if (this.queueDrawer.classList.contains('show')) {\n          this.renderQueueDrawerList();\n          this.queueDrawer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n        }\n      }\n\n      renderQueueDrawerList() {\n        if (!this.queueListContainer) return;\n        this.queueListContainer.innerHTML = '';\n\n        this.driveAudios.forEach((audio, idx) => {\n          const isCurrent = (idx === this.currentAudioIndex);\n          const item = document.createElement('div');\n          item.className = `queue-item ${isCurrent ? 'current' : ''}`;\n          item.innerHTML = `\n            <div style=\"display: flex; align-items: center; gap: 10px;\">\n              <span style=\"font-family: var(--font-mono); color: var(--sp-light-gray); width: 24px;\">${idx + 1}.</span>\n              <span style=\"font-weight: 600;\">${audio.name}</span>\n            </div>\n            <div style=\"display: flex; align-items: center; gap: 8px;\">\n              <span style=\"font-size: 11px; opacity: 0.8;\">${isCurrent ? '\ud83d\udfe2 \u6b63\u5728\u64ad\u653e' : '\u5f85\u64ad'}</span>\n              <span style=\"font-size: 14px;\">${isCurrent ? '\ud83d\udd0a' : '\u25b6'}</span>\n            </div>\n          `;\n          item.addEventListener('click', (e) => {\n            e.stopPropagation();\n            this.playDriveAudio(idx);\n          });\n          this.queueListContainer.appendChild(item);\n        });\n      }\n\n      cycleMusicLoopMode() {\n        if (this.loopMode === 'all') {\n          this.loopMode = 'shuffle';\n          this.playerLoopIcon.textContent = '\ud83d\udd00';\n          this.playerLoopText.textContent = '\u96a8\u6a5f\u64ad\u653e';\n          this.playerLoopPill.className = 'player-pill-control active-loop';\n        } else if (this.loopMode === 'shuffle') {\n          this.loopMode = 'seq';\n          this.playerLoopIcon.textContent = '\u27a1\ufe0f';\n          this.playerLoopText.textContent = '\u9806\u5e8f\u64ad\u653e';\n          this.playerLoopPill.className = 'player-pill-control';\n        } else {\n          this.loopMode = 'all';\n          this.playerLoopIcon.textContent = '\ud83d\udd01';\n          this.playerLoopText.textContent = '\u5168\u90e8\u5faa\u74b0';\n          this.playerLoopPill.className = 'player-pill-control active-loop';\n        }\n      }\n\n      toggleMusicSingleRepeat() {\n        this.singleRepeat = !this.singleRepeat;\n        if (this.singleRepeat) {\n          this.playerRepeatPill.className = 'player-pill-control active-repeat';\n          this.playerRepeatText.textContent = '\u55ae\u66f2\u91cd\u8907: \u958b';\n        } else {\n          this.playerRepeatPill.className = 'player-pill-control';\n          this.playerRepeatText.textContent = '\u55ae\u66f2\u91cd\u8907: \u95dc';\n        }\n      }\n\n      handleAudioEnded() {\n        if (this.singleRepeat) {\n          // \ud83d\udd02 \u55ae\u66f2\u91cd\u8907\n          this.audio.currentTime = 0;\n          this.audio.play();\n          return;\n        }\n\n        if (this.loopMode === 'shuffle') {\n          // \ud83d\udd00 \u96a8\u6a5f\u64ad\u653e\n          const randIdx = Math.floor(Math.random() * this.driveAudios.length);\n          this.playDriveAudio(randIdx);\n          return;\n        }\n\n        if (this.loopMode === 'all') {\n          // \ud83d\udd01 \u5168\u90e8\u5faa\u74b0\n          const nextIdx = (this.currentAudioIndex + 1) % this.driveAudios.length;\n          this.playDriveAudio(nextIdx);\n          return;\n        }\n\n        // \u27a1\ufe0f \u9806\u5e8f\u64ad\u653e (\u5230\u6700\u5f8c\u4e00\u9996\u505c\u6b62)\n        if (this.currentAudioIndex < this.driveAudios.length - 1) {\n          this.playDriveAudio(this.currentAudioIndex + 1);\n        }\n      }\n\n      handlePrevAction() {\n        if (this.currentView === 'english-view') {\n          this.jumpSentence(-1);\n        } else {\n          const prevIdx = (this.currentAudioIndex - 1 + this.driveAudios.length) % this.driveAudios.length;\n          this.playDriveAudio(prevIdx);\n        }\n      }\n\n      handleNextAction() {\n        if (this.currentView === 'english-view') {\n          this.jumpSentence(1);\n        } else {\n          const nextIdx = (this.currentAudioIndex + 1) % this.driveAudios.length;\n          this.playDriveAudio(nextIdx);\n        }\n      }\n\n      playDriveAudio(index) {\n        if (index < 0 || index >= this.driveAudios.length) return;\n        this.currentAudioIndex = index;\n        const track = this.driveAudios[index];\n\n        this.barTitle.textContent = `\u23f3 \u8f09\u5165\u97f3\u6a94: ${track.name}`;\n        this.barArtist.textContent = 'Google Drive \u96f2\u7aef\u97f3\u6a02\u4e32\u6d41';\n        this.audio.src = '';\n\n        if (track.url) {\n          this.audio.src = track.url;\n          this.barTitle.textContent = track.name;\n          this.audio.play();\n          return;\n        }\n\n        // Call GAS getAudioBase64\n        if (typeof google !== 'undefined' && google.script && google.script.run) {\n          google.script.run\n            .withSuccessHandler((base64Data) => {\n              if (base64Data && !base64Data.startsWith('ERROR')) {\n                this.barTitle.textContent = track.name;\n                this.audio.src = base64Data;\n                this.audio.play();\n              } else {\n                this.barTitle.textContent = '\u274c \u97f3\u6a94\u8b80\u53d6\u5931\u6557';\n              }\n            })\n            .withFailureHandler(() => {\n              this.barTitle.textContent = '\u274c \u7db2\u8def\u9023\u7dda\u903e\u6642';\n            })\n            .getAudioBase64(track.id);\n        }\n      }\n\n      // ==================== ARTICLE PARSING & DRIVE SAVE ====================\n\n      parseAndRenderRawArticle(rawText) {\n        this.currentLessonSubtitle = document.getElementById('current-lesson-subtitle');\n        this.currentLessonSubtitle.textContent = 'Google \u5b98\u65b9 LanguageApp \u5373\u6642\u96d9\u8a9e\u89e3\u6790';\n\n        if (typeof google !== 'undefined' && google.script && google.script.run) {\n          google.script.run\n            .withSuccessHandler((res) => {\n              this.renderSentenceStream(res.sentences, res.translations);\n            })\n            .processArticle(rawText);\n        } else {\n          // Fallback parser\n          const cleanText = rawText.replace(/\\n+/g, ' ');\n          const matches = cleanText.match(/[^.!?]+[.!?]+/g) || [cleanText];\n          this.renderSentenceStream(matches, matches.map(() => ''));\n        }\n      }\n\n      saveArticleToCloud() {\n        const name = this.articleSaveName.value.trim();\n        const content = this.rawArticleInput.value.trim();\n        if (!name || !content) return alert('\u8acb\u5148\u8f38\u5165\u6587\u7ae0\u6a94\u540d\u8207\u5167\u5bb9\uff01');\n\n        this.saveArticleDriveBtn.textContent = '\u5132\u5b58\u4e2d...';\n        this.saveArticleDriveBtn.disabled = true;\n\n        if (typeof google !== 'undefined' && google.script && google.script.run) {\n          google.script.run\n            .withSuccessHandler((msg) => {\n              alert(msg);\n              this.saveArticleDriveBtn.textContent = '\u5132\u5b58\u5230\u96f2\u7aef\u786c\u789f';\n              this.saveArticleDriveBtn.disabled = false;\n              this.loadDriveAssets();\n            })\n            .saveArticleToDrive(name, content);\n        } else {\n          alert('\u5df2\u5728\u9810\u89bd\u6a21\u5f0f\u4e0b\u6a21\u64ec\u5132\u5b58\uff01');\n          this.saveArticleDriveBtn.textContent = '\u5132\u5b58\u5230\u96f2\u7aef\u786c\u789f';\n          this.saveArticleDriveBtn.disabled = false;\n        }\n      }\n\n      renderSampleLesson(key) {\n        const l = FALLBACK_LESSONS[key];\n        if (!l) return;\n        this.currentLessonTitle.textContent = l.title;\n        const s = l.sentences.map((x) => x.en);\n        const zh = l.sentences.map((x) => x.zh);\n        this.renderSentenceStream(s, zh);\n        this.audio.src = l.audio;\n      }\n\n      renderSentenceStream(sentences, translations) {\n        this.currentArticleSentences = sentences.map((en, i) => ({\n          en: en,\n          zh: translations[i] || ''\n        }));\n\n        this.subtitlesContainer.innerHTML = '';\n        this.currentArticleSentences.forEach((s, idx) => {\n          const row = document.createElement('div');\n          row.className = `sub-row ${idx === 0 ? 'active' : ''}`;\n          row.dataset.index = idx;\n\n          const words = s.en.split(/\\s+/);\n          const tokensHTML = words.map((w) => {\n            const clean = w.replace(/[^a-zA-Z]/g, '').toLowerCase();\n            const isSaved = this.vocab.some((v) => v.word.toLowerCase() === clean);\n            return `<span class=\"vt-word ${isSaved ? 'saved' : ''}\" data-word=\"${clean}\">${w}</span>`;\n          }).join(' ');\n\n          row.innerHTML = `\n            <div class=\"sub-time\">\n              <span>\u7b2c ${idx + 1} \u53e5</span>\n              <span class=\"repeat-tag\">\ud83d\udd01 \u55ae\u53e5\u5faa\u74b0\u4e2d</span>\n            </div>\n            <div class=\"sub-en\">${tokensHTML}</div>\n            <div class=\"sub-zh\" style=\"display: ${this.showChinese ? 'block' : 'none'};\">${s.zh}</div>\n          `;\n\n          row.addEventListener('click', (e) => {\n            if (e.target.classList.contains('vt-word')) {\n              this.handleWordLookup(e.target.dataset.word, s.en, s.zh);\n              return;\n            }\n            this.activeSentenceIndex = idx;\n            this.highlightSentence(idx);\n            this.speak(s.en);\n          });\n\n          this.subtitlesContainer.appendChild(row);\n        });\n      }\n\n      highlightSentence(idx) {\n        const rows = this.subtitlesContainer.querySelectorAll('.sub-row');\n        rows.forEach((r, i) => {\n          r.classList.toggle('active', i === idx);\n          r.classList.toggle('looping', i === idx && this.isLoopingSentence);\n          if (i === idx) r.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n        });\n      }\n\n      updateLoopTag() {\n        const rows = this.subtitlesContainer.querySelectorAll('.sub-row');\n        rows.forEach((r, i) => {\n          r.classList.toggle('looping', i === this.activeSentenceIndex && this.isLoopingSentence);\n        });\n      }\n\n      jumpSentence(delta) {\n        if (this.currentArticleSentences.length === 0) return;\n        const targetIdx = Math.max(0, Math.min(this.currentArticleSentences.length - 1, this.activeSentenceIndex + delta));\n        this.activeSentenceIndex = targetIdx;\n        this.highlightSentence(targetIdx);\n        this.speak(this.currentArticleSentences[targetIdx].en);\n      }\n\n      // ==================== WORD SELECTION & FLASHCARDS ====================\n\n      initTextSelection() {\n        document.addEventListener('mouseup', (e) => {\n          const sel = window.getSelection();\n          const selectedText = sel ? sel.toString().trim() : '';\n\n          if (selectedText && selectedText.length > 1 && !this.dictPopup.contains(e.target)) {\n            const anchorNode = sel.anchorNode;\n            let current = anchorNode ? anchorNode.parentElement : null;\n            let sentenceRow = null;\n            while (current && current !== document.body) {\n              if (current.classList && current.classList.contains('sub-row')) {\n                sentenceRow = current;\n                break;\n              }\n              current = current.parentElement;\n            }\n\n            if (sentenceRow) {\n              const idx = parseInt(sentenceRow.dataset.index);\n              const s = this.currentArticleSentences[idx];\n\n              if (s) {\n                this.activeSelectionSentence = s;\n                const rect = sel.getRangeAt(0).getBoundingClientRect();\n                this.selectionTooltip.style.top = `${window.scrollY + rect.bottom + 8}px`;\n                this.selectionTooltip.style.left = `${window.scrollX + rect.left + rect.width / 2 - 40}px`;\n                this.selectionTooltip.style.display = 'block';\n                this.pendingSelectedWord = selectedText;\n                return;\n              }\n            }\n          }\n          this.selectionTooltip.style.display = 'none';\n        });\n\n        this.selectionTooltip.addEventListener('click', () => {\n          this.selectionTooltip.style.display = 'none';\n          if (this.pendingSelectedWord && this.activeSelectionSentence) {\n            this.handleWordLookup(\n              this.pendingSelectedWord,\n              this.activeSelectionSentence.en,\n              this.activeSelectionSentence.zh\n            );\n          }\n        });\n      }\n\n      handleWordLookup(word, contextEn, contextZh) {\n        if (!word) return;\n        this.currentExampleEn = contextEn;\n        this.currentExampleZh = contextZh;\n\n        this.dictTitle.textContent = word;\n        this.dictContext.textContent = `\u201c${contextEn}\u201d`;\n        this.dictPhonetic.textContent = '\u67e5\u8a62\u4e2d...';\n        this.dictMeaning.textContent = '\u6b63\u5728\u547c\u53eb\u5373\u6642\u7ffb\u8b6f\u5f15\u64ce...';\n\n        this.dictPopup.style.display = 'block';\n        this.dictBackdrop.style.display = 'block';\n\n        const local = QUICK_DICT[word.toLowerCase()];\n        if (local) {\n          this.dictPhonetic.textContent = local.ipa;\n          this.dictMeaning.textContent = local.meaning;\n          return;\n        }\n\n        if (typeof google !== 'undefined' && google.script && google.script.run) {\n          google.script.run\n            .withSuccessHandler((res) => {\n              if (res.success) {\n                this.dictPhonetic.textContent = `/${word}/`;\n                this.dictMeaning.textContent = `\u3010\u4e2d\u6587\u91cb\u7fa9\u3011${res.translated}`;\n              } else {\n                this.fetchFreeDictFallback(word);\n              }\n            })\n            .withFailureHandler(() => {\n              this.fetchFreeDictFallback(word);\n            })\n            .apiTranslateText(word);\n        } else {\n          this.fetchFreeDictFallback(word);\n        }\n      }\n\n      fetchFreeDictFallback(word) {\n        fetch(`https://api.dictionaryapi.dev/api/v2/entries/en/${encodeURIComponent(word)}`)\n          .then((r) => r.json())\n          .then((data) => {\n            if (Array.isArray(data) && data.length > 0) {\n              const entry = data[0];\n              const ipa = entry.phonetic || (entry.phonetics && entry.phonetics[0] ? entry.phonetics[0].text : `/${word}/`);\n              const def = entry.meanings[0].definitions[0].definition;\n              const pos = entry.meanings[0].partOfSpeech;\n              this.dictPhonetic.textContent = ipa;\n              this.dictMeaning.textContent = `[${pos}] ${def}`;\n            } else {\n              this.dictPhonetic.textContent = `/${word}/`;\n              this.dictMeaning.textContent = `\u3010\u55ae\u5b57\u3011${word}`;\n            }\n          })\n          .catch(() => {\n            this.dictPhonetic.textContent = `/${word}/`;\n            this.dictMeaning.textContent = `\u3010\u55ae\u5b57\u3011${word}`;\n          });\n      }\n\n      closeDict() {\n        this.dictPopup.style.display = 'none';\n        this.dictBackdrop.style.display = 'none';\n      }\n\n      // ==================== FLASHCARDS ====================\n\n      renderFlashcard() {\n        this.sidebarFcCount.textContent = this.vocab.length;\n        if (this.vocab.length === 0) {\n          this.fcProgressDisplay.textContent = '0 / 0';\n          this.fcWordFront.textContent = '\u5c1a\u7121\u751f\u5b57\u5361';\n          this.fcIpaFront.textContent = '';\n          this.fcMeaningBack.textContent = '\u5728\u6587\u7ae0\u4e2d\u9ede\u9078\u6216\u5708\u9078\u4efb\u4f55\u5b57\u8a5e\uff0c\u5373\u53ef\u81ea\u52d5\u5b58\u5165\u751f\u5b57\u5361\u8207\u4f8b\u53e5\uff01';\n          this.fcExampleEnBack.innerHTML = '';\n          this.fcExampleZhBack.textContent = '';\n          return;\n        }\n\n        if (this.activeFcIndex >= this.vocab.length) this.activeFcIndex = 0;\n        if (this.activeFcIndex < 0) this.activeFcIndex = this.vocab.length - 1;\n\n        const card = this.vocab[this.activeFcIndex];\n        this.activeFcCard.classList.remove('is-flipped');\n\n        this.fcProgressDisplay.textContent = `${this.activeFcIndex + 1} / ${this.vocab.length} ${card.mastered ? '(\u5df2\u638c\u63e1 \u2705)' : ''}`;\n        this.fcWordFront.textContent = card.word;\n        this.fcIpaFront.textContent = card.phonetic || `/${card.word}/`;\n\n        this.fcMeaningBack.textContent = card.meaning;\n        \n        let highlightedExample = card.example_en || '';\n        if (highlightedExample && card.word) {\n          const reg = new RegExp(`(${card.word})`, 'gi');\n          highlightedExample = highlightedExample.replace(reg, '<b>$1</b>');\n        }\n        this.fcExampleEnBack.innerHTML = `\u201c${highlightedExample}\u201d`;\n        this.fcExampleZhBack.textContent = card.example_zh || '';\n        this.fcMasterBtn.textContent = card.mastered ? '\ud83c\udf1f \u5df2\u638c\u63e1' : '\u2705 \u6a19\u8a18\u5df2\u638c\u63e1';\n      }\n\n      flipFlashcard() {\n        this.activeFcCard.classList.toggle('is-flipped');\n      }\n\n      jumpFlashcard(delta) {\n        if (this.vocab.length === 0) return;\n        this.activeFcIndex += delta;\n        this.renderFlashcard();\n      }\n\n      toggleMasterActiveCard() {\n        if (this.vocab.length === 0) return;\n        const card = this.vocab[this.activeFcIndex];\n        card.mastered = !card.mastered;\n        this.syncVocabToStorage();\n        if (typeof google !== 'undefined' && google.script && google.script.run) {\n          google.script.run.apiToggleMastered(card.id);\n        }\n        this.renderFlashcard();\n      }\n\n      // ==================== STORAGE & SYNC ====================\n\n      loadVocabFromStorage() {\n        if (typeof google !== 'undefined' && google.script && google.script.run) {\n          google.script.run\n            .withSuccessHandler((res) => {\n              if (res.success && res.data) {\n                this.vocab = res.data;\n                this.sidebarFcCount.textContent = this.vocab.length;\n                this.renderFlashcard();\n              }\n            })\n            .apiGetVocabList();\n        } else {\n          try {\n            const raw = localStorage.getItem('oscarmark_fc_vault');\n            this.vocab = raw ? JSON.parse(raw) : [];\n            this.sidebarFcCount.textContent = this.vocab.length;\n            this.renderFlashcard();\n          } catch {\n            this.vocab = [];\n          }\n        }\n      }\n\n      syncVocabToStorage() {\n        this.sidebarFcCount.textContent = this.vocab.length;\n        try {\n          localStorage.setItem('oscarmark_fc_vault', JSON.stringify(this.vocab));\n        } catch {}\n      }\n\n      saveWord(item) {\n        item.id = Date.now();\n        item.mastered = false;\n\n        const existingIdx = this.vocab.findIndex((v) => v.word.toLowerCase() === item.word.toLowerCase());\n        if (existingIdx >= 0) {\n          this.vocab[existingIdx] = Object.assign(this.vocab[existingIdx], item);\n        } else {\n          this.vocab.unshift(item);\n        }\n\n        this.syncVocabToStorage();\n\n        if (typeof google !== 'undefined' && google.script && google.script.run) {\n          google.script.run.apiSaveVocab(item);\n        }\n\n        document.querySelectorAll(`.vt-word[data-word=\"${item.word.toLowerCase()}\"]`).forEach((el) => {\n          el.classList.add('saved');\n        });\n\n        alert(`\ud83c\udf89 \u5df2\u6210\u529f\u5efa\u7acb\u751f\u5b57\u5361\u300c${item.word}\u300d\uff01\\n\ud83d\udccc \u81ea\u52d5\u6536\u9304\u4f8b\u53e5\uff1a\\n\"${item.example_en}\"`);\n        this.closeDict();\n        this.renderFlashcard();\n      }\n\n      renderVault() {\n        this.sidebarFcCount.textContent = this.vocab.length;\n        this.vaultGrid.innerHTML = '';\n\n        if (this.vocab.length === 0) {\n          this.vaultGrid.innerHTML = `\n            <div style=\"grid-column: 1/-1; text-align: center; color: var(--sp-light-gray); padding: 50px;\">\n              \ud83d\udcd6 \u76ee\u524d\u751f\u5b57\u5361\u5eab\u70ba\u7a7a\u3002\u5728\u6587\u7ae0\u4e2d\u9ede\u9078\u4efb\u4f55\u55ae\u5b57\uff0c\u5373\u53ef\u9ede\u64ca\u300c\u5b58\u70ba\u751f\u5b57\u5361\u300d\uff01\n            </div>\n          `;\n          return;\n        }\n\n        this.vocab.forEach((v) => {\n          const card = document.createElement('div');\n          card.className = 'vault-card';\n          card.innerHTML = `\n            <div class=\"vault-top\">\n              <span class=\"vault-word\">${v.word}</span>\n              <div style=\"display: flex; gap: 8px;\">\n                <button class=\"player-btn speak-v\" title=\"\u767c\u97f3\">\ud83d\udd0a</button>\n                <button class=\"player-btn del-v\" style=\"color: var(--danger);\" title=\"\u522a\u9664\">\u2715</button>\n              </div>\n            </div>\n            <div class=\"vault-phonetic\">${v.phonetic || ''}</div>\n            <div class=\"vault-meaning\">${v.meaning}</div>\n            ${v.example_en ? `<div class=\"vault-ctx\">\u201c${v.example_en}\u201d<br><small style=\"color:var(--sp-light-gray);\">${v.example_zh || ''}</small></div>` : ''}\n          `;\n\n          card.querySelector('.speak-v').addEventListener('click', () => this.speak(v.word));\n          card.querySelector('.del-v').addEventListener('click', () => {\n            this.vocab = this.vocab.filter((x) => x.id !== v.id);\n            this.syncVocabToStorage();\n            if (typeof google !== 'undefined' && google.script && google.script.run) {\n              google.script.run.apiDeleteVocab(v.id);\n            }\n            this.renderVault();\n            this.renderFlashcard();\n          });\n\n          this.vaultGrid.appendChild(card);\n        });\n      }\n\n      exportAnkiCSV() {\n        if (this.vocab.length === 0) return alert('\u751f\u8a5e\u5eab\u76ee\u524d\u70ba\u7a7a\u3002');\n        let csv = 'Front,Back,Example\\n';\n        this.vocab.forEach((v) => {\n          const front = `\"${v.word} ${v.phonetic || ''}\"`;\n          const back = `\"${v.meaning.replace(/\"/g, '\"\"')}\"`;\n          const ex = `\"${(v.example_en || '').replace(/\"/g, '\"\"')}\\n${(v.example_zh || '').replace(/\"/g, '\"\"')}\"`;\n          csv += `${front},${back},${ex}\\n`;\n        });\n        const blob = new Blob(['\\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });\n        const url = URL.createObjectURL(blob);\n        const a = document.createElement('a');\n        a.href = url;\n        a.download = `oscarmark_flashcards_${Date.now()}.csv`;\n        a.click();\n      }\n\n      // ==================== UTILS ====================\n\n      onTimeUpdate() {\n        const cur = this.audio.currentTime;\n        const dur = this.audio.duration || 0;\n        if (dur > 0) {\n          const pct = (cur / dur) * 100;\n          this.barProgressFill.style.width = `${pct}%`;\n          this.timeCurrent.textContent = this.formatTime(cur);\n        }\n      }\n\n      speak(text) {\n        if ('speechSynthesis' in window) {\n          window.speechSynthesis.cancel();\n          const u = new SpeechSynthesisUtterance(text);\n          u.lang = 'en-US';\n          u.rate = (this.playbackSpeed || 1.0) * 0.9;\n          window.speechSynthesis.speak(u);\n        }\n      }\n\n      // ==================== VOICETUBE \u82f1\u6587\u8dd1\u8d77\u4f86 (\u5168\u81ea\u52d5\u6717\u8b80) ====================\n\n      togglePlayAllSentences() {\n        if (this.isPlayingAllSentences) {\n          this.stopAutoReading();\n        } else {\n          this.startAutoReading();\n        }\n      }\n\n      startAutoReading() {\n        if (this.currentArticleSentences.length === 0) return alert('\u5c1a\u672a\u8f09\u5165\u6587\u7ae0\u5167\u5bb9');\n        this.isPlayingAllSentences = true;\n        this.vtPlayAllBtn.className = 'vt-btn vt-play-btn-prominent reading';\n        this.vtPlayAllIcon.textContent = '\u23f8';\n        this.vtPlayAllText.textContent = '\u66ab\u505c\u6717\u8b80\u5168\u6587';\n\n        // \u66ab\u505c\u80cc\u666f\u97f3\u6a02\u4ee5\u5c08\u6ce8\u807d\u82f1\u6587\n        if (!this.audio.paused) {\n          this.audio.pause();\n        }\n\n        this.speakSentenceSequence(this.activeSentenceIndex);\n      }\n\n      stopAutoReading() {\n        this.isPlayingAllSentences = false;\n        if ('speechSynthesis' in window) {\n          window.speechSynthesis.cancel();\n        }\n        if (this.vtPlayAllBtn) {\n          this.vtPlayAllBtn.className = 'vt-btn vt-play-btn-prominent';\n          this.vtPlayAllIcon.textContent = '\u25b6';\n          this.vtPlayAllText.textContent = '\u958b\u59cb\u5168\u6587\u6717\u8b80 (\u82f1\u6587\u8dd1\u8d77\u4f86)';\n        }\n        this.clearSpeakingHighlight();\n      }\n\n      speakSentenceSequence(idx) {\n        if (!this.isPlayingAllSentences) return;\n        if (idx < 0 || idx >= this.currentArticleSentences.length) {\n          if (this.isLoopingArticle) {\n            idx = 0;\n          } else {\n            this.stopAutoReading();\n            return;\n          }\n        }\n\n        this.activeSentenceIndex = idx;\n        const sentence = this.currentArticleSentences[idx];\n        this.highlightSentence(idx);\n        this.markSpeakingHighlight(idx);\n\n        // Update Bottom Bar info\n        this.barTitle.textContent = `\ud83c\udf99\ufe0f \u82f1\u8a9e\u7cbe\u8b80\u6717\u8b80\u4e2d\uff1a\u7b2c ${idx + 1} / ${this.currentArticleSentences.length} \u53e5`;\n        this.barArtist.textContent = sentence.en.slice(0, 40) + '...';\n\n        if ('speechSynthesis' in window) {\n          window.speechSynthesis.cancel();\n          const u = new SpeechSynthesisUtterance(sentence.en);\n          u.lang = 'en-US';\n          u.rate = (this.playbackSpeed || 1.0) * 0.9;\n\n          u.onend = () => {\n            this.clearSpeakingHighlight();\n\n            if (this.isLoopingSentence) {\n              // \ud83d\udd02 \u55ae\u53e5\u91cd\u8907\uff1a\u505c 700ms \u5f8c\u91cd\u8907\u540c\u4e00\u53e5\n              setTimeout(() => {\n                if (this.isLoopingSentence && this.isPlayingAllSentences) {\n                  this.speakSentenceSequence(idx);\n                }\n              }, 700);\n            } else if (this.isPlayingAllSentences) {\n              // \u27a1\ufe0f \u5168\u6587\u9023\u7e8c\u8dd1\uff1a\u505c 600ms \u5f8c\u81ea\u52d5\u9032\u5165\u4e0b\u4e00\u53e5\uff01\n              setTimeout(() => {\n                if (this.isPlayingAllSentences) {\n                  this.speakSentenceSequence(idx + 1);\n                }\n              }, 600);\n            }\n          };\n\n          u.onerror = () => {\n            this.clearSpeakingHighlight();\n          };\n\n          window.speechSynthesis.speak(u);\n        }\n      }\n\n      markSpeakingHighlight(idx) {\n        const rows = this.subtitlesContainer.querySelectorAll('.sub-row');\n        rows.forEach((r, i) => {\n          if (i === idx) {\n            r.classList.add('speaking');\n            r.scrollIntoView({ behavior: 'smooth', block: 'center' });\n          } else {\n            r.classList.remove('speaking');\n          }\n        });\n      }\n\n      clearSpeakingHighlight() {\n        const rows = this.subtitlesContainer.querySelectorAll('.sub-row');\n        rows.forEach(r => r.classList.remove('speaking'));\n      }\n\n      toggleSingleRepeatSentence() {\n        this.isLoopingSentence = !this.isLoopingSentence;\n        if (this.isLoopingSentence) {\n          this.vtRepeatBtn.className = 'vt-btn player-pill-control active-repeat';\n          this.vtSingleRepeatStatus.textContent = '\u958b';\n        } else {\n          this.vtRepeatBtn.className = 'vt-btn player-pill-control';\n          this.vtSingleRepeatStatus.textContent = '\u95dc';\n        }\n      }\n\n      toggleLoopArticle() {\n        this.isLoopingArticle = !this.isLoopingArticle;\n        if (this.isLoopingArticle) {\n          this.vtLoopArticleBtn.className = 'vt-btn player-pill-control active-loop';\n          this.vtAllLoopStatus.textContent = '\u958b';\n        } else {\n          this.vtLoopArticleBtn.className = 'vt-btn player-pill-control';\n          this.vtAllLoopStatus.textContent = '\u95dc';\n        }\n      }\n\n      formatTime(secs) {\n        const m = Math.floor(secs / 60);\n        const s = Math.floor(secs % 60);\n        return `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;\n      }\n\n      initShadowing() {\n        const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;\n        if (!SpeechRec) {\n          this.recordBtn.textContent = '\u700f\u89bd\u5668\u4e0d\u652f\u63f4\u8a9e\u97f3';\n          this.recordBtn.disabled = true;\n          return;\n        }\n\n        const recognition = new SpeechRec();\n        recognition.lang = 'en-US';\n        recognition.interimResults = true;\n\n        let recording = false;\n        this.recordBtn.addEventListener('click', () => {\n          if (!recording) {\n            recognition.start();\n            recording = true;\n            this.recordBtn.classList.add('recording');\n            this.recordBtn.textContent = '\ud83d\udd34 \u9304\u97f3\u4e2d...\u8acb\u6717\u8b80';\n          } else {\n            recognition.stop();\n            recording = false;\n            this.recordBtn.classList.remove('recording');\n            this.recordBtn.textContent = '\ud83c\udfa4 \u958b\u59cb\u8ddf\u8b80';\n          }\n        });\n\n        recognition.onresult = (e) => {\n          const transcript = Array.from(e.results).map((r) => r[0].transcript).join('');\n          this.shadowResult.textContent = `\u60a8\u7684\u767c\u97f3: \"${transcript}\"`;\n\n          const target = (this.currentArticleSentences[this.activeSentenceIndex]?.en || '').toLowerCase().replace(/[^a-z0-9\\s]/g, '');\n          const user = transcript.toLowerCase().replace(/[^a-z0-9\\s]/g, '');\n\n          const targetWords = target.split(/\\s+/);\n          const userWords = user.split(/\\s+/);\n          const matched = targetWords.filter((w) => userWords.includes(w)).length;\n          const score = Math.round((matched / Math.max(1, targetWords.length)) * 100);\n\n          this.shadowScore.textContent = `\u6e96\u78ba\u5ea6: ${score}%`;\n          this.shadowScore.classList.toggle('good', score >= 75);\n        };\n\n        recognition.onend = () => {\n          recording = false;\n          this.recordBtn.classList.remove('recording');\n          this.recordBtn.textContent = '\ud83c\udfa4 \u958b\u59cb\u8ddf\u8b80';\n        };\n      }\n    }\n\n    window.addEventListener('DOMContentLoaded', () => {\n      window.app = new AppManager();\n    });\n  </script>\n</body>\n</html>\n";

function doGet(e) {
  return HtmlService.createHtmlOutput(EMBEDDED_HTML)
